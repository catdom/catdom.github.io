---
import Nav from './Nav.astro';
import Cover from './Cover.astro';
import Marquee from './Marquee.astro';
import Capability from './Capability.astro';
import Where from './Where.astro';
import Figures from './Figures.astro';
import Footer from './Footer.astro';
import type { Lang } from '../data/types';

interface Props { lang: Lang }
const { lang } = Astro.props;
---

<Nav lang={lang} path="" />
<main id="main">
  <Cover lang={lang} />
  <Marquee lang={lang} />
  <Capability lang={lang} />
  <Where lang={lang} />
  <Figures lang={lang} />
</main>
<Footer lang={lang} />
