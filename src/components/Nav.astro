---
import { site, nav, ui } from '../data/site';
import { LANGS, langPrefix, type Lang } from '../data/types';

interface Props {
  lang: Lang;
  /** Path after the language prefix, so the switcher keeps you on the page. */
  path?: string;
  /** Home page has in-page anchors; case pages link back instead. */
  anchors?: boolean;
}
const { lang, path = '', anchors = true } = Astro.props;
const home = `${langPrefix(lang)}/`;
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a class="mark" href={home} aria-label={site.name}>
      {/* The wordmark as outlines rather than live text: identical on every
          machine, and no swap when the webfont lands. Traced from Geist at
          600 weight with the same kerning and -0.03em tracking the text
          version had, so it lands on the same 29.33 x 18.4px box. */}
      <svg viewBox="0 0 1594 1000" width="29.33" height="18.4" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M-3.4 971V871.8H50.4Q78.8 871.8 94 859.5Q109.2 847.2 109.2 812.6V287H237.2V816.6Q237.2 899.4 200 935.2Q162.8 971 73.2 971ZM106.8 215.6V102.4H239.6V215.6Z M569.8 833Q490.2 833 431.3 798.6Q372.4 764.2 339.8 701.3Q307.2 638.4 307.2 554Q307.2 469.6 339.8 407.2Q372.4 344.8 431.3 309.9Q490.2 275 569.8 275Q637.6 275 690.9 298.9Q744.2 322.8 777.6 367.6Q811 412.4 819.2 476.2L686.8 483Q679 432 647.6 405.5Q616.2 379 569.8 379Q508 379 473.8 425.3Q439.6 471.6 439.6 554Q439.6 636.8 473.8 683.1Q508 729.4 569.8 729.4Q616.6 729.4 648.2 702Q679.8 674.6 686.8 618.2L819.2 624.2Q811.4 688 778.4 734.9Q745.4 781.8 692.1 807.4Q638.8 833 569.8 833Z M1068.4 833Q1000.2 833 950.5 798.8Q900.8 764.6 874 702Q847.2 639.4 847.2 554Q847.2 468.6 874.2 406Q901.2 343.4 951.1 309.2Q1001 275 1068.4 275Q1124.2 275 1166.6 298.1Q1209 321.2 1230.6 362.6V111H1358.6V821H1237.4L1234.4 741.8Q1212.4 784.8 1168.4 808.9Q1124.4 833 1068.4 833ZM1107 729.4Q1146.8 729.4 1174.3 709Q1201.8 688.6 1216.2 649.3Q1230.6 610 1230.6 554Q1230.6 496.8 1216.2 457.8Q1201.8 418.8 1174.3 398.7Q1146.8 378.6 1107 378.6Q1048.6 378.6 1014.1 425.5Q979.6 472.4 979.6 554Q979.6 634.2 1014.3 681.8Q1049 729.4 1107 729.4Z M1438.2 821V681.2H1584.4V821Z" />
      </svg>
    </a>

    <nav class="nav__links" aria-label="Sections">
      {
        anchors
          ? nav[lang].map((item) => <a href={item.href}>{item.label}</a>)
          : <a href={home}>{ui[lang].backHome}</a>
      }
    </nav>

    <div class="nav__right">
      <button
        type="button"
        class="burger"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="visually-hidden">{ui[lang].menu}</span>
        <span class="burger__bars" aria-hidden="true"></span>
      </button>

      <div class="lang" role="group" aria-label={ui[lang].langLabel}>
        {
          LANGS.map((l) => (
            <a
              href={`${langPrefix(l)}${path}/`.replace(/\/+$/, '/')}
              hreflang={l}
              lang={l}
              class:list={['lang__opt', { 'is-on': l === lang }]}
              aria-current={l === lang ? 'true' : undefined}
            >
              {l.toUpperCase()}
            </a>
          ))
        }
      </div>

      <a class="pill pill--solid nav__cta" href={`mailto:${site.email}`}>{ui[lang].contact}</a>
    </div>
  </div>

  <div class="sheet" id="mobile-menu" data-menu hidden>
    <nav class="sheet__nav" aria-label={ui[lang].menu}>
      {
        anchors
          ? nav[lang].map((item) => <a href={item.href}>{item.label}</a>)
          : <a href={home}>{ui[lang].backHome}</a>
      }
    </nav>
    <div class="sheet__foot">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    /* Sits over both light and dark sections; the tone is swapped by JS. */
    color: var(--ink);
    transition:
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
    /* Declared transparent up front so the border can transition in rather
       than appearing the instant the class lands. */
    background-color: transparent;
    border-bottom: 1px solid transparent;
  }

  /* Once the page has moved, the bar earns a translucent band the width of
     the viewport. The tone follows the section underneath. */
  :global(.nav.is-scrolled) {
    background-color: color-mix(in srgb, var(--paper) 72%, transparent);
    border-bottom-color: var(--lavender-line);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  :global(.nav.is-scrolled.is-on-dark) {
    background-color: color-mix(in srgb, var(--dark) 68%, transparent);
    border-bottom-color: var(--dark-line);
  }

  /* The sheet already covers the viewport; a band and a rule across the bar
     would only cut it in half. */
  :global(.nav.menu-open),
  :global(.nav.menu-open.is-scrolled) {
    background-color: transparent;
    border-bottom-color: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .nav__inner {
    max-width: var(--maxw);
    margin-inline: auto;
    padding: clamp(0.9rem, 1.6vw, 1.4rem) var(--gutter);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .mark {
    flex: none;
    display: block;
    line-height: 0;
  }

  .mark svg { display: block; }

  .nav__links {
    display: none;
    margin-left: auto;
    gap: clamp(1rem, 2vw, 2rem);
    font-size: 0.9375rem;
  }

  .nav__links a {
    position: relative;
    padding-block: 0.15rem;
  }

  .nav__links a::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease);
  }

  .nav__links a:hover::after { transform: scaleX(1); }

  .nav__right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.2vw, 1rem);
  }

  .lang {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid currentColor;
    border-radius: var(--r-pill);
    opacity: 0.55;
    transition: opacity var(--dur-fast) var(--ease);
  }

  .lang:hover { opacity: 1; }

  .lang__opt {
    padding: 0.25rem 0.55rem;
    border-radius: var(--r-pill);
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.03em;
  }

  /* The active language reads as a filled chip in either tone. */
  .lang__opt.is-on {
    background: color-mix(in oklab, currentColor 14%, transparent);
    font-weight: 500;
  }

  /* --- Mobile menu --------------------------------------------------------- */

  .burger {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid currentColor;
    border-radius: var(--r-pill);
    color: inherit;
  }

  .burger__bars {
    position: relative;
    width: 15px;
    height: 9px;
  }

  .burger__bars::before,
  .burger__bars::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    transition: transform var(--dur-fast) var(--ease);
  }

  .burger__bars::before { top: 0; }
  .burger__bars::after { bottom: 0; }

  .burger[aria-expanded='true'] .burger__bars::before { transform: translateY(3.75px) rotate(45deg); }
  .burger[aria-expanded='true'] .burger__bars::after { transform: translateY(-3.75px) rotate(-45deg); }

  .sheet {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--dark);
    color: var(--on-dark);
    padding: 6rem var(--gutter) 2.5rem;
    /* Must stay `none` on the base class: a `display` here would override the
       `hidden` attribute and leave an invisible overlay eating every tap. */
    display: none;
    align-content: space-between;
    gap: 2rem;
    /* Animated by JS so `hidden` still keeps it out of the a11y tree. */
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .sheet:not([hidden]) { display: grid; }

  .sheet.is-open { opacity: 1; }

  .sheet__nav {
    display: grid;
    gap: 0.35rem;
    font-size: clamp(1.75rem, 9vw, 2.5rem);
    letter-spacing: var(--track-h2);
    line-height: 1.15;
  }

  .sheet__foot {
    display: grid;
    gap: 0.6rem;
    font-size: var(--fs-small);
    color: var(--on-dark-muted);
    padding-top: 1.5rem;
    border-top: 1px solid var(--dark-line);
  }

  @media (min-width: 860px) {
    .nav__links { display: flex; }
    .nav__right { margin-left: 0; }
    .burger { display: none; }
    .sheet,
    .sheet:not([hidden]) { display: none; }
  }

  @media (max-width: 420px) {
    .nav__cta { display: none; }
  }

  /* Tone swap driven by which section is under the header — and forced while
     the dark menu sheet is open, or the bar would sit dark-on-dark. */
  :global(.nav.is-on-dark),
  :global(.nav.menu-open) { color: var(--on-dark); }

  :global(.nav.is-on-dark) .pill--solid,
  :global(.nav.menu-open) .pill--solid {
    background: var(--lavender);
    color: var(--ink);
  }

  :global(.nav.is-on-dark) .pill--solid:hover,
  :global(.nav.menu-open) .pill--solid:hover { background: var(--paper); }
</style>
