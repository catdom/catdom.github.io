---
import { site, nav, ui } from '../data/site';
import { LANGS, langPrefix, type Lang } from '../data/types';

interface Props {
  lang: Lang;
  /** Path after the language prefix, so the switcher keeps you on the page. */
  path?: string;
  /** Home page has in-page anchors; case pages link back instead. */
  anchors?: boolean;
}
const { lang, path = '', anchors = true } = Astro.props;
const home = `${langPrefix(lang)}/`;
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a class="mark" href={home} aria-label={site.name}>
      <svg viewBox="0 0 42 24" width="42" height="24" aria-hidden="true">
        <path
          d="M13 3v12a6 6 0 0 1-6 6 6 6 0 0 1-5-2.7"
          fill="none"
          stroke="currentColor"
          stroke-width="3.1"
          stroke-linecap="round"></path>
        <path
          d="M39 6.6A9 9 0 0 0 32 3a9 9 0 0 0 0 18 9 9 0 0 0 7-3.6"
          fill="none"
          stroke="currentColor"
          stroke-width="3.1"
          stroke-linecap="round"></path>
      </svg>
    </a>

    <nav class="nav__links" aria-label="Sections">
      {
        anchors
          ? nav[lang].map((item) => <a href={item.href}>{item.label}</a>)
          : <a href={home}>{ui[lang].backHome}</a>
      }
    </nav>

    <div class="nav__right">
      <button
        type="button"
        class="burger"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="visually-hidden">{ui[lang].menu}</span>
        <span class="burger__bars" aria-hidden="true"></span>
      </button>

      <div class="lang" role="group" aria-label={ui[lang].langLabel}>
        {
          LANGS.map((l) => (
            <a
              href={`${langPrefix(l)}${path}/`.replace(/\/+$/, '/')}
              hreflang={l}
              lang={l}
              class:list={['lang__opt', { 'is-on': l === lang }]}
              aria-current={l === lang ? 'true' : undefined}
            >
              {l.toUpperCase()}
            </a>
          ))
        }
      </div>

      <a class="pill pill--solid nav__cta" href={`mailto:${site.email}`}>{ui[lang].contact}</a>
    </div>
  </div>

  <div class="sheet" id="mobile-menu" data-menu hidden>
    <nav class="sheet__nav" aria-label={ui[lang].menu}>
      {
        anchors
          ? nav[lang].map((item) => <a href={item.href}>{item.label}</a>)
          : <a href={home}>{ui[lang].backHome}</a>
      }
    </nav>
    <div class="sheet__foot">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    /* Sits over both light and dark sections; the tone is swapped by JS. */
    color: var(--ink);
    transition: color var(--dur) var(--ease);
  }

  .nav__inner {
    max-width: var(--maxw);
    margin-inline: auto;
    padding: clamp(0.9rem, 1.6vw, 1.4rem) var(--gutter);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .mark {
    flex: none;
    display: block;
  }

  .nav__links {
    display: none;
    margin-left: auto;
    gap: clamp(1rem, 2vw, 2rem);
    font-size: 0.9375rem;
  }

  .nav__links a {
    position: relative;
    padding-block: 0.15rem;
  }

  .nav__links a::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease);
  }

  .nav__links a:hover::after { transform: scaleX(1); }

  .nav__right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.2vw, 1rem);
  }

  .lang {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid currentColor;
    border-radius: var(--r-pill);
    opacity: 0.55;
    transition: opacity var(--dur-fast) var(--ease);
  }

  .lang:hover { opacity: 1; }

  .lang__opt {
    padding: 0.25rem 0.55rem;
    border-radius: var(--r-pill);
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.03em;
  }

  /* The active language reads as a filled chip in either tone. */
  .lang__opt.is-on {
    background: color-mix(in oklab, currentColor 14%, transparent);
    font-weight: 500;
  }

  /* --- Mobile menu --------------------------------------------------------- */

  .burger {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid currentColor;
    border-radius: var(--r-pill);
    color: inherit;
  }

  .burger__bars {
    position: relative;
    width: 15px;
    height: 9px;
  }

  .burger__bars::before,
  .burger__bars::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    transition: transform var(--dur-fast) var(--ease);
  }

  .burger__bars::before { top: 0; }
  .burger__bars::after { bottom: 0; }

  .burger[aria-expanded='true'] .burger__bars::before { transform: translateY(3.75px) rotate(45deg); }
  .burger[aria-expanded='true'] .burger__bars::after { transform: translateY(-3.75px) rotate(-45deg); }

  .sheet {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--dark);
    color: var(--on-dark);
    padding: 6rem var(--gutter) 2.5rem;
    /* Must stay `none` on the base class: a `display` here would override the
       `hidden` attribute and leave an invisible overlay eating every tap. */
    display: none;
    align-content: space-between;
    gap: 2rem;
    /* Animated by JS so `hidden` still keeps it out of the a11y tree. */
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .sheet:not([hidden]) { display: grid; }

  .sheet.is-open { opacity: 1; }

  .sheet__nav {
    display: grid;
    gap: 0.35rem;
    font-size: clamp(1.75rem, 9vw, 2.5rem);
    letter-spacing: var(--track-h2);
    line-height: 1.15;
  }

  .sheet__foot {
    display: grid;
    gap: 0.6rem;
    font-size: var(--fs-small);
    color: var(--on-dark-muted);
    padding-top: 1.5rem;
    border-top: 1px solid var(--dark-line);
  }

  @media (min-width: 860px) {
    .nav__links { display: flex; }
    .nav__right { margin-left: 0; }
    .burger { display: none; }
    .sheet,
    .sheet:not([hidden]) { display: none; }
  }

  @media (max-width: 420px) {
    .nav__cta { display: none; }
  }

  /* Tone swap driven by which section is under the header — and forced while
     the dark menu sheet is open, or the bar would sit dark-on-dark. */
  :global(.nav.is-on-dark),
  :global(.nav.menu-open) { color: var(--on-dark); }

  :global(.nav.is-on-dark) .pill--solid,
  :global(.nav.menu-open) .pill--solid {
    background: var(--lavender);
    color: var(--ink);
  }

  :global(.nav.is-on-dark) .pill--solid:hover,
  :global(.nav.menu-open) .pill--solid:hover { background: var(--paper); }
</style>
