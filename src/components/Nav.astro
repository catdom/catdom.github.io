---
import { site, nav, ui } from '../data/site';
import { LANGS, langPrefix, type Lang } from '../data/types';
import Button from './ui/Button.astro';

interface Props {
  lang: Lang;
  /** Path after the language prefix, so the switcher keeps you on the page. */
  path?: string;
  /** Home page has in-page anchors; case pages link back instead. */
  anchors?: boolean;
}
const { lang, path = '', anchors = true } = Astro.props;
const home = `${langPrefix(lang)}/`;

/* Anchor items belong to the home page; page items take the language prefix. */
const href = (to: string) => (to.startsWith('#') ? to : `${langPrefix(lang)}${to}`);
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a class="mark" href={home} aria-label={site.name}>catdom.</a>

    <nav class="nav__links" aria-label="Sections">
      {
        anchors
          ? nav[lang].map((item) => <a href={href(item.href)}>{item.label}</a>)
          : <a href={home}>{ui[lang].backHome}</a>
      }
    </nav>

    <div class="nav__right">
      <div class="lang" role="group" aria-label={ui[lang].langLabel}>
        {
          LANGS.map((l) => (
            <a
              href={`${langPrefix(l)}${path}/`.replace(/\/+$/, '/')}
              hreflang={l}
              lang={l}
              class:list={['lang__opt', { 'is-on': l === lang }]}
              aria-current={l === lang ? 'true' : undefined}
            >
              {l.toUpperCase()}
            </a>
          ))
        }
      </div>

      <!-- Contact is LinkedIn: the site has no form and no mailto. -->
      <Button as="a" class="nav__cta" href={site.linkedin} rel="me noopener" target="_blank">
        {ui[lang].contact}
      </Button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    color: var(--ink);
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  /* Once the page has moved, the bar earns a band the width of the viewport. */
  :global(.nav.is-scrolled) {
    background-color: color-mix(in srgb, var(--paper) 82%, transparent);
    border-bottom-color: var(--rule);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  /* The bar's ground runs up behind the status bar; its contents start below
     it, so the clock and the camera never sit on the wordmark. */
  .nav { padding-top: env(safe-area-inset-top, 0px); }

  .nav__inner {
    max-width: var(--maxw);
    margin-inline: auto;
    padding: clamp(0.8rem, 1.4vw, 1.2rem) var(--gutter);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* Set like a title rather than a logotype: the same face the headings use,
     declared here rather than inherited, at their weight and their tracking.
     One voice for everything the site says in DM Sans. */
  .mark {
    flex: none;
    display: block;
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: var(--track-h2);
    line-height: 1;
  }

  .nav__links {
    display: none;
    margin-left: auto;
    gap: clamp(1rem, 2vw, 2rem);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    font-weight: 500;
  }

  .nav__links a { position: relative; padding-block: 0.15rem; }

  .nav__links a::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: var(--mark);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease);
  }

  .nav__links a:hover::after { transform: scaleX(1); }

  .nav__right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.2vw, 1rem);
  }

  .lang {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--rule);
    border-radius: var(--r-pill);
  }

  .lang__opt {
    padding: 0.25rem 0.55rem;
    border-radius: var(--r-pill);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  .lang__opt.is-on { background: var(--ink); color: var(--paper); }

  /* The bar is two things, not three columns: the wordmark on the page's left
     edge and the menu — links, language, CTA — closing on its right edge. */
  @media (min-width: 860px) {
    .nav__links { display: flex; margin-left: auto; }
    .nav__right { margin-left: 0; }
  }

  /* Touch: the wordmark and the language chips are the two smallest controls
     on the bar. Grow their hit areas to a thumb without redrawing them — the
     wordmark borrows the padding back with a negative margin so the bar keeps
     its height, and the chips simply get taller, matching the CTA. */
  @media (pointer: coarse) {
    .mark {
      padding: 0.85rem 0.4rem;
      margin: -0.85rem -0.4rem;
    }

    .nav__cta { height: 44px; }

    .lang__opt {
      display: flex;
      align-items: center;
      min-height: 38px;
      padding-inline: 0.85rem;
    }
  }
</style>
