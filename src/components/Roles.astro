---
import { intro } from '../data/home';
import { featuredCases } from '../data/cases';
import { langPrefix, type Lang } from '../data/types';
import Icon from './Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const i = intro[lang];
const base = langPrefix(lang);
---

<section class="roles" id="roles">
  <div class="shell">
    <div class="roles__panel split" data-tone="light" data-tonefade>
    <p class="eyebrow roles__label" data-reveal>{i.label}</p>

    <div class="roles__main">
      <h2 class="h2 roles__heading" data-reveal>{i.heading}</h2>

      <div class="roles__body prose-col">
        {i.body.map((para, n) => (
          <p class="lead" data-reveal style={`--reveal-delay:${n * 90}ms`}>{para}</p>
        ))}
      </div>

      <ol class="rolelist" data-rolelist>
        {featuredCases.map((c, n) => (
          <li data-reveal style={`--reveal-delay:${n * 90}ms`}>
            <a class="rolerow" href={`${base}/work/${c.slug}/`}>
              <span class="rolerow__num">({String(n + 1).padStart(2, '0')})</span>
              <span class="rolerow__text">
                <span class="rolerow__company">{c.company}</span>
                <span class="rolerow__role">{c.role[lang]}</span>
              </span>
              <span class="rolerow__period">{c.period[lang]}</span>
              <Icon name="arrow-up-right" size={20} class="rolerow__arrow" />
            </a>
          </li>
        ))}
      </ol>
    </div>
    </div>
  </div>
</section>

<style>
  /* Opens on the hero's own ground so the two sections read as one surface,
     then crosses to dark once a third of it has been scrolled past. Both the
     ground and the ink cross together, or the text would vanish mid-fade. */
  .roles {
    background: var(--paper);
    padding-block: clamp(1rem, 3vw, 2.5rem);
  }

  /* A rounded panel like the other two, rather than a full-bleed band. */
  .roles__panel {
    --pad-x: clamp(2rem, 3.5vw, 3.5rem);
    /* The hover pill must contrast with the ground it sits on, and while the
       panel is light that ground IS the lavender the pill would have used. */
    --row-fill: var(--paper);
    border-radius: var(--r-band);
    padding: clamp(3rem, 6vw, 6rem) var(--pad-x);
    color: var(--ink);

    /* The ground is interpolated from the scroll position, not animated on a
       timer: in the reference it tracks the finger, and a timed fade fired at
       a threshold always reads as detached from the scroll. --tone-p runs 0
       to 1 as the panel arrives, set by the script.

       Only the ink transitions, and briefly. It cannot cross-fade with the
       ground — both pass through the same luminance and the text disappears —
       so it cuts at the halfway point instead. */
    background: color-mix(in oklab, var(--lavender), var(--dark) calc(var(--tone-p, 0) * 100%));
    transition: color 120ms linear;
  }

  :global(.roles__panel.is-dark) {
    color: var(--on-dark);
    --row-fill: var(--lavender);
  }

  @media (prefers-reduced-motion: reduce) {
    .roles__panel { transition: none; }
  }

  .roles__label { padding-top: 0.6rem; }

  .roles__main { display: grid; gap: clamp(2rem, 3.5vw, 3rem); }

  .roles__heading { max-width: 22ch; }

  .roles__body { display: grid; gap: 1.15rem; }

  .rolelist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }

  /* The reference's signature interaction: the whole row fills with a pale
     pill on hover, the type flips to dark, and an arrow slides in. */
  .rolerow {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
    padding: clamp(0.85rem, 1.4vw, 1.15rem) clamp(1rem, 1.6vw, 1.4rem);
    border-radius: 12px;
    transition:
      background var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      opacity var(--dur-fast) var(--ease);
  }

  .rolerow:hover,
  .rolerow:focus-visible {
    background: var(--row-fill);
    color: var(--ink);
    outline: none;
  }

  /* Siblings recede while one row is hovered. */
  .rolelist:hover li:not(:hover) .rolerow { opacity: 0.45; }

  .rolerow__num {
    font-size: var(--fs-row);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
    transition: opacity var(--dur-fast) var(--ease);
  }

  .rolerow__text {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    min-width: 0;
  }

  .rolerow__company {
    font-size: var(--fs-row);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .rolerow__role {
    font-size: var(--fs-small);
    opacity: 0.7;
    transition: opacity var(--dur-fast) var(--ease);
  }

  .rolerow__period {
    font-size: var(--fs-small);
    white-space: nowrap;
    opacity: 0.6;
    transition: opacity var(--dur-fast) var(--ease);
  }

  .rolerow:hover .rolerow__period { color: var(--ink-muted); }

  .rolerow__arrow {
    opacity: 0;
    transform: translate(-6px, 6px);
    transition: opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }

  .rolerow:hover .rolerow__arrow,
  .rolerow:focus-visible .rolerow__arrow {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 720px) {
    .rolerow { grid-template-columns: auto minmax(0, 1fr) auto; }
    .rolerow__period { display: none; }
    /* On touch there is no hover, so the arrow is always visible. */
    .rolerow__arrow { opacity: 0.5; transform: none; }
  }
</style>
