---
import { board } from '../data/home';
import type { Lang } from '../data/types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const b = board[lang];

/* The switch is two radios, so the board works with no JavaScript at all and
   reads to assistive tech as what it is: a two-option choice. Both inputs sit
   before everything they style, since the reveal is a sibling selector.

   Components are grouped six to a board rather than one per cell: a cell with
   two or three related components reads as a library page instead of a mostly
   empty box, and it keeps the whole thing to a third of the height in one
   column on a phone.

   Every dimension is anchored to an edge or a percentage of the component it
   measures — never to a hand-guessed offset — so a change of font, language or
   column width moves the line with the thing it describes. Every label names
   the property it measures; the key at the foot of the board decodes them. */
---

<section class="board" aria-label={b.label}>
  <input class="visually-hidden board__radio" type="radio" name="ds-mode" id="ds-design" checked />
  <input class="visually-hidden board__radio" type="radio" name="ds-mode" id="ds-specs" />

  <div class="board__bar">
    <p class="meta board__label">{b.label}</p>
    <div class="seg" role="group">
      <label class="seg__opt" for="ds-design">{b.design}</label>
      <label class="seg__opt" for="ds-specs">{b.specs}</label>
    </div>
  </div>

  <div class="board__grid" tabindex="0" role="group" aria-label={b.label}>
    <!-- Actions & navigation ------------------------------------------------------ -->
    <div class="cell">
      <p class="meta cell__name"><b>C-01</b> Button, tag &amp; tabs</p>
      <div class="cell__body">
        <div class="an an--fit" style="display:flex;align-items:center;gap:12px">
          <button class="ds-btn" type="button" data-box>Publish</button>
          <button class="ds-btn ds-btn--ghost" type="button">Cancel</button>
          <span class="dm dm--v dm--left" style="--h:100%"><i>H 40</i></span>
          <span class="dm dm--h dm--under" style="--l:0;--w:16px"><i>P 16</i></span>
          <span class="cl cl--right" style="--t:8px"><i>R 999</i></span>
          <span class="cl cl--right" style="--t:calc(100% - 8px)"><i><em style="--c:var(--mark)"></em>mark</i></span>
        </div>
        <div class="an an--fit" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
          <span class="ds-badge" data-box>Tokens</span>
          <span class="ds-badge ds-badge--solid">Adopted</span>
          <span class="dm dm--v dm--left" style="--h:24px"><i>H 24</i></span>
          <span class="dm dm--h dm--under" style="--l:0;--w:10px"><i>P 10</i></span>
        </div>
        <div class="an ds-tabs">
          <span class="ds-tab is-on">Overview</span>
          <span class="ds-tab">Tokens</span>
          <span class="ds-tab">Usage</span>
          <span class="dm dm--v dm--right" style="--t:auto;--b:2px;--h:10px"><i>P 10</i></span>
          <span class="cl cl--left" style="--t:calc(100% - 2px)"><i>B 2</i></span>
        </div>
      </div>
    </div>

    <!-- Fields ------------------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-02</b> Text field &amp; dropdown</p>
      <div class="cell__body">
        <div class="an">
          <label class="ds-lab" for="ds-mail">Work email</label>
          <div class="ds-field" data-box><span>jordi@studio.com</span></div>
          <span class="cl cl--right" style="--t:calc(100% - 22px)"><i>R 8</i></span>
          <span class="cl cl--left" style="--t:calc(100% - 22px)"><i>T 14</i></span>
          <span class="dm dm--h dm--under" style="--l:0;--w:16px"><i>P 16</i></span>
        </div>
        <div class="an">
          <div class="ds-field ds-field--trigger" data-box>
            <span>Design Ops</span>
            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false"><path d="M4 6.5L8 10.5L12 6.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="ds-menu" data-box>
            <span class="ds-menu__item">UX Strategy</span>
            <span class="ds-menu__item is-on">Design Ops<svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true" focusable="false"><path d="M3.5 8.5l3 3 6-6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="ds-menu__item">Design Systems</span>
          </div>
          <span class="dm dm--v dm--left" style="--t:0;--h:44px"><i>H 44</i></span>
          <span class="dm dm--v dm--right" style="--t:44px;--h:4px"><i>G 4</i></span>
          <span class="dm dm--v dm--left" style="--t:53px;--h:34px"><i>H 34</i></span>
        </div>
      </div>
    </div>

    <!-- Selection ---------------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-03</b> Radio, checkbox &amp; switch</p>
      <div class="cell__body">
        <div class="an an--fit ds-stack">
          <span class="ds-choice"><i class="ds-radio is-on"></i>Remote</span>
          <span class="ds-choice"><i class="ds-radio"></i>Hybrid</span>
          <span class="dm dm--h dm--over" style="--l:0;--w:18px"><i>W 18</i></span>
          <span class="dm dm--v dm--right" style="--t:19px;--h:12px"><i>G 12</i></span>
        </div>
        <div class="an an--fit ds-stack">
          <span class="ds-choice"><i class="ds-check is-on"><svg viewBox="0 0 16 16" width="10" height="10" aria-hidden="true" focusable="false"><path d="M3.5 8.5l3 3 6-6.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></i>Send me the deck</span>
          <span class="ds-choice"><i class="ds-switch is-on"></i>Notifications</span>
          <span class="dm dm--h dm--over" style="--l:0;--w:16px"><i>W 16</i></span>
          <span class="dm dm--v dm--right" style="--t:auto;--b:0;--h:22px"><i>H 22</i></span>
          <span class="dm dm--h dm--under" style="--l:0;--w:40px"><i>W 40</i></span>
        </div>
      </div>
    </div>

    <!-- Card --------------------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-04</b> Card</p>
      <div class="cell__body">
        <div class="an">
          <div class="ds-card" data-box>
            <span class="ds-badge">Design system</span>
            <h4 class="ds-card__title">SUI, seven brands</h4>
            <p class="ds-card__text">One foundation, local freedom. Tokens, components and the governance that kept it adopted.</p>
            <div class="ds-card__foot">
              <span class="ds-meta">2021 &mdash; 2025</span>
              <span class="ds-link">Read <svg viewBox="0 0 16 16" width="10" height="10" aria-hidden="true" focusable="false"><path d="M4 12L12 4M12 4H5.5M12 4v6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </div>
          </div>
          <span class="dm dm--h dm--over" style="--l:0;--w:20px"><i>P 20</i></span>
          <span class="cl cl--right" style="--t:8px"><i>R 12</i></span>
          <span class="cl cl--right" style="--t:calc(100% - 24px)"><i><em style="--c:var(--paper)"></em>paper</i></span>
          <span class="dm dm--v dm--left" style="--t:44px;--h:8px"><i>G 8</i></span>
          <span class="cl cl--right" style="--t:calc(100% - 40px)"><i>B 1</i></span>
        </div>
      </div>
    </div>

    <!-- Input --------------------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-05</b> Slider &amp; list row</p>
      <div class="cell__body">
        <div class="an" style="display:flex;align-items:center;gap:12px">
          <span class="ds-slider__track"><span class="ds-slider__fill"></span><span class="ds-slider__knob"></span></span>
          <span class="ds-meta">64%</span>
          <span class="dm dm--h dm--over" style="--l:0;--w:64%"><i>W 64%</i></span>
          <span class="dm dm--h dm--under" style="--l:calc(64% - 8px);--w:16px"><i>W 16</i></span>
          <span class="cl cl--left" style="--t:50%"><i>H 4</i></span>
        </div>
        <div class="an an--fit" style="display:flex;align-items:center;gap:12px">
          <span class="ds-avatar">JC</span>
          <span class="ds-row__text"><b>Jordi Catal&aacute;n</b><span class="ds-meta">Design Ops</span></span>
          <span class="dm dm--h dm--over" style="--l:0;--w:36px"><i>W 36</i></span>
          <span class="cl cl--right" style="--t:50%"><i>T 13</i></span>
        </div>
      </div>
    </div>

    <!-- Data --------------------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-06</b> Table &amp; notice</p>
      <div class="cell__body">
        <div class="an">
          <div class="ds-table" data-box>
            <span class="ds-table__r ds-table__r--head"><span>Component</span><span>Use</span></span>
            <span class="ds-table__r"><span>Button</span><span>412</span></span>
            <span class="ds-table__r"><span>Field</span><span>287</span></span>
          </div>
          <span class="dm dm--v dm--left" style="--t:0;--h:32px"><i>H 32</i></span>
          <span class="dm dm--v dm--left" style="--t:33px;--h:36px"><i>H 36</i></span>
          <span class="cl cl--right" style="--t:8px"><i>R 8</i></span>
        </div>
        <div class="an">
          <div class="ds-note" data-box>
            <span class="ds-note__dot"></span>
            <span>Two components share a name. Rename one before publishing.</span>
          </div>
          <span class="dm dm--h dm--over" style="--l:0;--w:12px"><i>P 12</i></span>
          <span class="cl cl--left" style="--t:50%"><i>B 2</i></span>
        </div>
      </div>
    </div>

    <!-- Navigation --------------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-07</b> Breadcrumb &amp; pagination</p>
      <div class="cell__body">
        <div class="an an--fit ds-crumb">
          <span>Systems</span>
          <s class="an">/<span class="dm dm--h dm--over" style="--l:-8px;--w:8px"><i>G 8</i></span></s>
          <span>Tokens</span>
          <s>/</s>
          <b>Spacing</b>
          <span class="cl cl--right" style="--t:50%"><i>T 12</i></span>
        </div>
        <div class="an an--fit ds-pager">
          <span class="ds-pager__b">&#8249;</span>
          <span class="an an--fit" style="display:flex"><span class="ds-pager__b is-on">1</span><span class="dm dm--h dm--under" style="--w:100%"><i>W 32</i></span></span>
          <span class="ds-pager__b">2</span>
          <span class="ds-pager__b">3</span>
          <span class="ds-pager__b">&#8250;</span>
          <span class="dm dm--v dm--left" style="--h:100%"><i>H 32</i></span>
          <span class="cl cl--right" style="--t:50%"><i>R 6</i></span>
        </div>
      </div>
    </div>

    <!-- Search & segmented ------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-08</b> Search &amp; segmented</p>
      <div class="cell__body">
        <div class="an">
          <div class="ds-search" data-box>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10.5 10.5L14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <span>Search components</span>
          </div>
          <span class="dm dm--v dm--left" style="--h:100%"><i>H 40</i></span>
          <span class="dm dm--h dm--under" style="--l:0;--w:12px"><i>P 12</i></span>
          <span class="cl cl--right" style="--t:50%"><i><em style="--c:var(--rule)"></em>rule</i></span>
        </div>
        <div class="an an--fit">
          <div class="ds-seg" data-box>
            <span class="ds-seg__o is-on">Light</span>
            <span class="ds-seg__o">Dark</span>
          </div>
          <span class="dm dm--v dm--left" style="--h:100%"><i>H 36</i></span>
          <span class="dm dm--h dm--under" style="--l:0;--w:3px"><i>P 3</i></span>
        </div>
      </div>
    </div>

    <!-- Stepper & progress ------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-09</b> Stepper &amp; progress</p>
      <div class="cell__body">
        <div class="an an--fit ds-steps">
          <span class="ds-step is-done">1</span>
          <span class="ds-step__line an"><span class="dm dm--h dm--over" style="--w:100%"><i>W 24</i></span></span>
          <span class="ds-step is-on">2</span>
          <span class="ds-step__line"></span>
          <span class="ds-step">3</span>
          <span class="dm dm--v dm--left" style="--h:100%"><i>H 24</i></span>
        </div>
        <div class="an">
          <span class="ds-prog"><span class="ds-prog__fill"></span></span>
          <span class="dm dm--h dm--over" style="--l:0;--w:40%"><i>W 40%</i></span>
          <span class="cl cl--left" style="--t:50%"><i>H 6</i></span>
          <span class="cl cl--right" style="--t:50%"><i>R 999</i></span>
        </div>
      </div>
    </div>

    <!-- Tooltip & toast ---------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-10</b> Tooltip &amp; toast</p>
      <div class="cell__body">
        <div class="an an--fit ds-tipwrap">
          <span class="ds-tip">Tokens only</span>
          <span class="ds-badge">Hover</span>
          <span class="dm dm--h dm--over" style="--l:0;--w:8px"><i>P 8</i></span>
          <span class="cl cl--right" style="--t:12px"><i>R 6</i></span>
        </div>
        <div class="an ds-toast" data-box>
          <span>Component published</span>
          <b>Undo</b>
          <span class="dm dm--v dm--left" style="--h:100%"><i>H 48</i></span>
          <span class="cl cl--right" style="--t:50%"><i><em style="--c:var(--ink)"></em>ink</i></span>
        </div>
      </div>
    </div>

    <!-- Modal -------------------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-11</b> Modal</p>
      <div class="cell__body">
        <div class="an">
          <div class="ds-modal" data-box>
            <h4 class="ds-modal__t">Publish to seven brands?</h4>
            <p class="ds-modal__b">Every consumer picks this up on their next build.</p>
            <div class="ds-modal__f">
              <button class="ds-btn ds-btn--ghost ds-btn--sm" type="button">Cancel</button>
              <button class="ds-btn ds-btn--sm" type="button">Publish</button>
            </div>
          </div>
          <span class="dm dm--h dm--over" style="--l:0;--w:20px"><i>P 20</i></span>
          <span class="cl cl--right" style="--t:8px"><i>R 12</i></span>
          <span class="dm dm--v dm--left" style="--t:44px;--h:16px"><i>G 16</i></span>
        </div>
      </div>
    </div>

    <!-- Avatars & skeleton -------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-12</b> Avatar stack &amp; skeleton</p>
      <div class="cell__body">
        <div class="an an--fit ds-stack-a">
          <span class="ds-av an">JC<span class="dm dm--h dm--over" style="--w:100%"><i>W 28</i></span></span>
          <span class="ds-av">MR</span>
          <span class="ds-av">AL</span>
          <span class="ds-av ds-av--more">+4</span>
          <span class="dm dm--h dm--under" style="--l:20px;--w:8px"><i>G -8</i></span>
        </div>
        <div class="an ds-skel">
          <span class="ds-skel__l an" style="width:100%"><span class="cl cl--right" style="--t:50%"><i>H 12</i></span></span>
          <span class="ds-skel__l" style="width:64%"></span>
          <span class="dm dm--v dm--left" style="--t:20px;--h:8px"><i>G 8</i></span>
          <span class="cl cl--right" style="--t:calc(100% - 6px)"><i><em style="--c:var(--rule-2)"></em>rule-2</i></span>
        </div>
      </div>
    </div>
  </div>

  <!-- The foot carries the key and the scales the board is actually built on,
       so the numbers above resolve to a system rather than floating free. -->
  <div class="board__foot">
    <p class="meta board__hint">{b.hint}</p>
    <dl class="strip">
      <div><dt class="meta">{b.key}</dt><dd class="meta" set:html={b.keyValue}></dd></div>
      <div><dt class="meta">{b.space}</dt><dd class="meta"><span>4<b>space-1</b></span><span>8<b>space-2</b></span><span>12<b>space-3</b></span><span>16<b>space-4</b></span><span>20<b>space-5</b></span><span>24<b>space-6</b></span></dd></div>
      <div><dt class="meta">{b.radius}</dt><dd class="meta"><span>4<b>xs</b></span><span>6<b>sm</b></span><span>8<b>md</b></span><span>12<b>lg</b></span><span>999<b>full</b></span></dd></div>
      <div><dt class="meta">{b.type}</dt><dd class="meta"><span>11<b>xs</b></span><span>12<b>sm</b></span><span>13<b>base</b></span><span>14<b>md</b></span><span>16<b>lg</b></span></dd></div>
      <div><dt class="meta">{b.colour}</dt><dd class="meta swatches">
        <span><em style="--c:var(--ink)"></em>ink</span>
        <span><em style="--c:var(--ink-2)"></em>ink-2</span>
        <span><em style="--c:var(--ink-3)"></em>ink-3</span>
        <span><em style="--c:var(--mark)"></em>mark</span>
        <span><em style="--c:var(--rule)"></em>rule</span>
        <span><em style="--c:var(--paper)"></em>paper</span>
      </dd></div>
      <div><dt class="meta">{b.legend}</dt><dd class="meta">{b.unitsValue}</dd></div>
    </dl>
  </div>
</section>

<style>
  /* =====================================================================
     The board. The site's thesis, shown rather than claimed: a component
     library that can be read as design or as specification.

     Every number in an annotation is the number the CSS actually sets, so
     the spec view is true rather than decorative.
     ===================================================================== */

  .board {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--rule);
    background: var(--panel);
  }

  .board__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem 1.25rem;
    flex-wrap: wrap;
    padding: 0.75rem clamp(0.85rem, 2vw, 1.25rem);
    border-bottom: 1px solid var(--rule);
  }

  .board__label { color: var(--ink); }

  .seg {
    margin-left: auto;
    display: flex;
    padding: 3px;
    gap: 2px;
    border: 1px solid var(--rule);
    border-radius: var(--r-pill);
    background: var(--paper);
  }

  .seg__opt {
    display: flex;
    align-items: center;
    padding: 0.4rem 0.8rem;
    border-radius: var(--r-pill);
    font-size: var(--fs-meta);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    font-weight: 500;
    color: var(--ink-3);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .seg__opt:hover { color: var(--ink); }

  /* Twelve cells divide exactly by 4, 3, 2 and 1, so whatever the column
     count no empty grid area is left showing the gap colour. */
  .board__grid {
    display: grid;
    gap: 1px;
    background: var(--rule-2);
  }

  @media (min-width: 620px) { .board__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .board__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1320px) { .board__grid { grid-template-columns: repeat(4, 1fr); } }

  .cell {
    background: var(--panel);
    padding: clamp(1rem, 2vw, 1.5rem) clamp(0.85rem, 1.6vw, 1.25rem);
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .cell__name { color: var(--ink-3); }

  /* The body reserves the margins the dimension lines hang in: a left rail
     for heights, a right rail for callout labels, and slack above and below
     for the horizontal dimensions. Reserved in both modes, so nothing moves
     when the switch is thrown. The row gap has to clear a dimension hanging
     under one component and another hanging over the next. */
  .cell__body {
    display: grid;
    gap: 42px;
    padding: 20px 60px 24px 42px;
  }

  /* The anchor for every annotation: it hugs the component it wraps, so a
     dimension line set to 100% measures the component itself.

     It must never carry a border of its own: a percentage on an absolutely
     positioned child resolves against the padding box, so a bordered anchor
     makes every 100% line come up two pixels short of the number it prints. */
  .an { position: relative; width: 100%; }
  .an--fit { width: max-content; max-width: 100%; justify-self: start; }

  /* --- The components themselves ---------------------------------------- */

  .ds-btn {
    height: 40px;
    padding-inline: 16px;
    border-radius: 999px;
    background: var(--mark);
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
  }

  .ds-btn--ghost {
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--rule);
  }

  .ds-lab { font-size: 12px; font-weight: 500; color: var(--ink-2); margin-bottom: 8px; }

  .ds-field {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    height: 44px;
    padding-inline: 16px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--paper);
    font-size: 14px;
  }

  .ds-field span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .ds-menu {
    margin-top: 4px;
    padding: 4px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--panel);
    display: grid;
  }

  .ds-menu__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    height: 34px;
    padding-inline: 10px;
    border-radius: 6px;
    font-size: 13px;
    color: var(--ink-2);
  }

  .ds-menu__item.is-on { background: var(--paper); color: var(--mark); font-weight: 500; }

  .ds-stack { display: grid; gap: 12px; }

  .ds-choice { display: flex; align-items: center; gap: 10px; font-size: 13px; line-height: 19px; }

