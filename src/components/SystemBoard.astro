---
import { board } from '../data/home';
import type { Lang } from '../data/types';
import Button from './ui/Button.astro';
import Tag from './ui/Tag.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const b = board[lang];

/* The mode switch is two radios, so the board works with no JavaScript at all
   and reads to assistive tech as what it is: a two-option choice. Both inputs
   sit before everything they style, since the reveal is a sibling selector.

   The components are real, not pictures of components: native buttons, inputs,
   radios, details and a range slider, so hover, focus, active, checked and open
   are the browser's own states rather than classes pretending to be them. Every
   interaction here runs on CSS — nothing on this page needs script.

   Every dimension is anchored to an edge or a percentage of the component it
   measures — never to a hand-guessed offset — so a change of font, language or
   column width moves the line with the thing it describes. Every label names
   the property it measures; the key at the foot of the board decodes them. */
---

<section class="board" aria-label={b.label}>
  <input class="visually-hidden board__radio" type="radio" name="ds-mode" id="ds-design" checked />
  <input class="visually-hidden board__radio" type="radio" name="ds-mode" id="ds-specs" />

  <div class="board__bar">
    <p class="meta board__label">{b.label}</p>
    <p class="meta board__live">{b.live}</p>
    <div class="seg" role="group">
      <label class="seg__opt" for="ds-design">{b.design}</label>
      <label class="seg__opt" for="ds-specs">{b.specs}</label>
    </div>
  </div>

  <div class="board__grid" tabindex="0" role="group" aria-label={b.label}>
    <!-- C-01 Button ------------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-01</b> Button<span class="cell__used">{b.shared}</span></p>
      <p class="meta cell__states">default &middot; hover &middot; active &middot; focus &middot; disabled</p>
      <div class="cell__body">
        <div class="an an--fit row" style="gap:12px;flex-wrap:wrap">
          <Button data-box>Publish</Button>
          <Button variant="ghost">Cancel</Button>
          <span class="dm dm--v dm--left" style="--h:40px"><i>H 40</i></span>
          <span class="dm dm--h dm--under" style="--l:0;--w:16px"><i>P 16</i></span>
          <span class="cl cl--right" style="--t:8px"><i>R 999</i></span>
        </div>
        <div class="an an--fit">
          <Button variant="ghost" disabled>Archived</Button>
        </div>
      </div>
    </div>

    <!-- C-02 Tag & chip --------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-02</b> Tag &amp; chip<span class="cell__used">{b.shared}</span></p>
      <p class="meta cell__states">default &middot; hover &middot; focus &middot; removable</p>
      <div class="cell__body">
        <div class="an an--fit row" style="gap:8px;flex-wrap:wrap">
          <Tag data-box>Tokens</Tag>
          <Tag variant="solid">Adopted</Tag>
          <span class="dm dm--v dm--left" style="--h:24px"><i>H 24</i></span>
          <span class="dm dm--h dm--under" style="--l:0;--w:10px"><i>P 10</i></span>
        </div>
        <div class="an an--fit row" style="gap:8px;flex-wrap:wrap">
          <span class="ds-chip">Design Ops<button class="ds-chip__x" type="button" aria-label="Remove Design Ops">&times;</button></span>
          <span class="ds-chip">Systems<button class="ds-chip__x" type="button" aria-label="Remove Systems">&times;</button></span>
        </div>
      </div>
    </div>

    <!-- C-03 Tabs --------------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-03</b> Tabs</p>
      <p class="meta cell__states">default &middot; hover &middot; selected &middot; focus</p>
      <div class="cell__body">
        <div class="an ds-tabs">
          <input class="visually-hidden" type="radio" name="ds-tab" id="ds-tab-1" checked />
          <input class="visually-hidden" type="radio" name="ds-tab" id="ds-tab-2" />
          <input class="visually-hidden" type="radio" name="ds-tab" id="ds-tab-3" />
          <label class="ds-tab" for="ds-tab-1">Overview</label>
          <label class="ds-tab" for="ds-tab-2">Tokens</label>
          <label class="ds-tab" for="ds-tab-3">Usage</label>
          <span class="dm dm--v dm--right" style="--t:auto;--b:2px;--h:10px"><i>P 10</i></span>
          <span class="cl cl--left" style="--t:calc(100% - 2px)"><i>B 2</i></span>
        </div>
      </div>
    </div>

    <!-- C-04 Text field --------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-04</b> Text field</p>
      <p class="meta cell__states">default &middot; hover &middot; focus &middot; filled &middot; error</p>
      <div class="cell__body">
        <div class="an">
          <label class="ds-lab" for="ds-mail">Work email</label>
          <input class="ds-field" id="ds-mail" type="email" value="jordi@studio.com" data-box />
          <span class="cl cl--right" style="--t:calc(100% - 22px)"><i>R 8</i></span>
          <span class="cl cl--left" style="--t:calc(100% - 22px)"><i>T 14</i></span>
          <span class="dm dm--h dm--under" style="--l:0;--w:16px"><i>P 16</i></span>
        </div>
        <div class="an">
          <label class="ds-lab" for="ds-team">Team size</label>
          <input class="ds-field ds-field--bad" id="ds-team" type="text" value="eight" aria-describedby="ds-team-e" />
          <p class="ds-err" id="ds-team-e">Use a number.</p>
          <span class="dm dm--v dm--left" style="--t:24px;--h:44px"><i>H 44</i></span>
        </div>
      </div>
    </div>

    <!-- C-05 Textarea ----------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-05</b> Textarea</p>
      <p class="meta cell__states">default &middot; hover &middot; focus &middot; resizable</p>
      <div class="cell__body">
        <div class="an">
          <label class="ds-lab" for="ds-note">Adoption note</label>
          <textarea class="ds-area" id="ds-note" rows="3" data-box>Two teams still ship their own button.</textarea>
          <span class="cl cl--right" style="--t:32px"><i>R 8</i></span>
          <span class="dm dm--h dm--under" style="--l:0;--w:12px"><i>P 12</i></span>
        </div>
      </div>
    </div>

    <!-- C-06 Dropdown ----------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-06</b> Dropdown</p>
      <p class="meta cell__states">closed &middot; open &middot; hover &middot; selected</p>
      <div class="cell__body">
        <div class="an">
          <details class="ds-drop" open>
            <summary class="ds-field ds-field--trigger" data-box>
              <span>Design Ops</span>
              <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false"><path d="M4 6.5L8 10.5L12 6.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="ds-menu">
              <button class="ds-menu__item" type="button">UX Strategy</button>
              <button class="ds-menu__item is-on" type="button" aria-current="true">Design Ops<svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true" focusable="false"><path d="M3.5 8.5l3 3 6-6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              <button class="ds-menu__item" type="button">Design Systems</button>
            </div>
          </details>
          <span class="dm dm--v dm--left" style="--t:0;--h:44px"><i>H 44</i></span>
          <span class="dm dm--v dm--right" style="--t:44px;--h:4px"><i>G 4</i></span>
          <span class="dm dm--v dm--left" style="--t:53px;--h:34px"><i>H 34</i></span>
        </div>
      </div>
    </div>

    <!-- C-07 Selection ---------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-07</b> Radio, checkbox &amp; switch</p>
      <p class="meta cell__states">unchecked &middot; checked &middot; hover &middot; focus</p>
      <div class="cell__body">
        <div class="an an--fit ds-stack">
          <label class="ds-choice"><input class="ds-radio" type="radio" name="ds-place" checked />Remote</label>
          <label class="ds-choice"><input class="ds-radio" type="radio" name="ds-place" />Hybrid</label>
          <span class="dm dm--h dm--over" style="--l:0;--w:18px"><i>W 18</i></span>
          <span class="dm dm--v dm--right" style="--t:19px;--h:12px"><i>G 12</i></span>
        </div>
        <div class="an an--fit ds-stack">
          <label class="ds-choice"><input class="ds-check" type="checkbox" checked />Send me the deck</label>
          <label class="ds-choice"><input class="ds-switch" type="checkbox" role="switch" checked />Notifications</label>
          <span class="dm dm--h dm--over" style="--l:0;--w:16px"><i>W 16</i></span>
          <span class="dm dm--v dm--right" style="--t:auto;--b:0;--h:22px"><i>H 22</i></span>
          <span class="dm dm--h dm--under" style="--l:0;--w:40px"><i>W 40</i></span>
        </div>
      </div>
    </div>

    <!-- C-08 Search & segmented ------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-08</b> Search &amp; segmented</p>
      <p class="meta cell__states">default &middot; hover &middot; focus &middot; selected</p>
      <div class="cell__body">
        <div class="an">
          <div class="ds-search" data-box>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10.5 10.5L14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <input type="search" size="8" placeholder="Search components" aria-label="Search components" />
          </div>
          <span class="dm dm--v dm--left" style="--h:40px"><i>H 40</i></span>
          <span class="dm dm--h dm--under" style="--l:0;--w:12px"><i>P 12</i></span>
          <span class="cl cl--right" style="--t:50%"><i><em style="--c:var(--rule)"></em>rule</i></span>
        </div>
        <div class="an an--fit">
          <div class="ds-seg" data-box>
            <input class="visually-hidden" type="radio" name="ds-theme" id="ds-th-1" checked />
            <input class="visually-hidden" type="radio" name="ds-theme" id="ds-th-2" />
            <label class="ds-seg__o" for="ds-th-1">Light</label>
            <label class="ds-seg__o" for="ds-th-2">Dark</label>
          </div>
          <span class="dm dm--v dm--left" style="--h:100%"><i>H 36</i></span>
          <span class="dm dm--h dm--under" style="--l:0;--w:3px"><i>P 3</i></span>
        </div>
      </div>
    </div>

    <!-- C-09 Slider & progress -------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-09</b> Slider &amp; progress</p>
      <p class="meta cell__states">default &middot; hover &middot; dragging &middot; focus</p>
      <div class="cell__body">
        <div class="an row" style="gap:12px">
          <input class="ds-range" type="range" min="0" max="100" value="64" aria-label="Coverage" />
          <output class="ds-meta">64%</output>
          <span class="cl cl--left" style="--t:50%"><i>H 4</i></span>
          <span class="cl cl--right" style="--t:50%"><i>W 16</i></span>
        </div>
        <div class="an">
          <span class="ds-prog"><span class="ds-prog__fill"></span></span>
          <span class="dm dm--h dm--over" style="--l:0;--w:40%"><i>W 40%</i></span>
          <span class="cl cl--right" style="--t:50%"><i>R 999</i></span>
        </div>
      </div>
    </div>

    <!-- C-10 Stepper & pagination ----------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-10</b> Stepper &amp; pagination</p>
      <p class="meta cell__states">done &middot; current &middot; to do &middot; hover &middot; selected</p>
      <div class="cell__body">
        <div class="an an--fit ds-steps">
          <span class="ds-step is-done">1</span>
          <span class="ds-step__line an"><span class="dm dm--h dm--over" style="--w:100%"><i>W 24</i></span></span>
          <span class="ds-step is-on" aria-current="step">2</span>
          <span class="ds-step__line"></span>
          <span class="ds-step">3</span>
          <span class="dm dm--v dm--left" style="--h:100%"><i>H 24</i></span>
        </div>
        <div class="an an--fit ds-pager">
          <button class="ds-pager__b" type="button" aria-label="Previous">&#8249;</button>
          <input class="visually-hidden" type="radio" name="ds-page" id="ds-pg-1" checked />
          <input class="visually-hidden" type="radio" name="ds-page" id="ds-pg-2" />
          <input class="visually-hidden" type="radio" name="ds-page" id="ds-pg-3" />
          <span class="an an--fit" style="display:flex"><label class="ds-pager__b" for="ds-pg-1">1</label><span class="dm dm--h dm--under" style="--w:100%"><i>W 32</i></span></span>
          <label class="ds-pager__b" for="ds-pg-2">2</label>
          <label class="ds-pager__b" for="ds-pg-3">3</label>
          <button class="ds-pager__b" type="button" aria-label="Next">&#8250;</button>
          <span class="dm dm--v dm--left" style="--h:100%"><i>H 32</i></span>
        </div>
      </div>
    </div>

    <!-- C-11 Card --------------------------------------------------------- -->
    <div class="cell" id="c-11">
      <p class="meta cell__name"><b>C-11</b> Card</p>
      <p class="meta cell__states">default &middot; hover &middot; focus</p>
      <div class="cell__body">
        <div class="an">
          <a class="ds-card" href="#c-11" data-box>
            <Tag>Design system</Tag>
            <h4 class="ds-card__title">SUI, seven brands</h4>
            <p class="ds-card__text">One foundation, local freedom. Tokens, components and the governance that kept it adopted.</p>
            <span class="ds-card__foot">
              <span class="ds-meta">2021 &mdash; 2025</span>
              <span class="ds-link">Read <svg viewBox="0 0 16 16" width="10" height="10" aria-hidden="true" focusable="false"><path d="M4 12L12 4M12 4H5.5M12 4v6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </span>
          </a>
          <span class="dm dm--h dm--over" style="--l:0;--w:20px"><i>P 20</i></span>
          <span class="cl cl--right" style="--t:8px"><i>R 12</i></span>
          <span class="cl cl--right" style="--t:calc(100% - 24px)"><i><em style="--c:var(--paper)"></em>paper</i></span>
        </div>
      </div>
    </div>

    <!-- C-12 Table -------------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-12</b> Table</p>
      <p class="meta cell__states">header &middot; row &middot; hover</p>
      <div class="cell__body">
        <div class="an">
          <table class="ds-table" data-box>
            <thead><tr><th>Component</th><th>Use</th></tr></thead>
            <tbody>
              <tr><td>Button</td><td>412</td></tr>
              <tr><td>Field</td><td>287</td></tr>
            </tbody>
          </table>
          <span class="dm dm--v dm--left" style="--t:0;--h:32px"><i>H 32</i></span>
          <span class="dm dm--v dm--left" style="--t:33px;--h:36px"><i>H 36</i></span>
          <span class="cl cl--right" style="--t:8px"><i>R 8</i></span>
        </div>
      </div>
    </div>

    <!-- C-13 Alerts ------------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-13</b> Alert</p>
      <p class="meta cell__states">info &middot; success &middot; warning &middot; danger</p>
      <div class="cell__body">
        <div class="an ds-alerts">
          <p class="ds-alert ds-alert--info" data-box><b>Info</b> Two components share a name.</p>
          <p class="ds-alert ds-alert--ok"><b>Published</b> SUI 4.2 is on every brand.</p>
          <p class="ds-alert ds-alert--warn"><b>Deprecated</b> Legacy button ships until June.</p>
          <p class="ds-alert ds-alert--bad"><b>Blocked</b> Token contrast fails AA.</p>
          <span class="dm dm--h dm--over" style="--l:0;--w:12px"><i>P 12</i></span>
          <span class="cl cl--left" style="--t:22px"><i>B 2</i></span>
        </div>
      </div>
    </div>

    <!-- C-14 Tooltip & toast ---------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-14</b> Tooltip &amp; toast</p>
      <p class="meta cell__states">hidden &middot; shown &middot; hover &middot; focus &middot; dismissed</p>
      <div class="cell__body">
        <div class="an an--fit ds-tipwrap">
          <Tag as="button" class="ds-tip__trigger">Hover me<span class="ds-tip" role="tooltip">Tokens only</span></Tag>
          <span class="cl cl--right" style="--t:50%"><i>R 6</i></span>
        </div>
        <div class="an">
          <input class="visually-hidden" type="checkbox" id="ds-toast-x" />
          <div class="ds-toast" data-box>
            <span>Component published</span>
            <span class="row" style="gap:4px">
              <button class="ds-toast__u" type="button">Undo</button>
              <label class="ds-toast__x" for="ds-toast-x" title="Dismiss">&times;</label>
            </span>
          </div>
          <label class="ds-toast__back meta" for="ds-toast-x">Restore toast</label>
          <span class="dm dm--v dm--left" style="--h:48px"><i>H 48</i></span>
          <span class="cl cl--right" style="--t:24px"><i><em style="--c:var(--ink)"></em>ink</i></span>
        </div>
      </div>
    </div>

    <!-- C-15 Modal -------------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-15</b> Modal</p>
      <p class="meta cell__states">closed &middot; open &middot; hover &middot; focus</p>
      <div class="cell__body">
        <div class="an">
          <details class="ds-dialog" open>
            <Button as="summary" variant="ghost" size="sm">Open dialog</Button>
            <div class="ds-modal" data-box>
              <h4 class="ds-modal__t">Publish to seven brands?</h4>
              <p class="ds-modal__b">Every consumer picks this up on their next build.</p>
              <div class="ds-modal__f">
                <Button variant="ghost" size="sm">Cancel</Button>
                <Button size="sm">Publish</Button>
              </div>
            </div>
          </details>
          <span class="cl cl--right" style="--t:64px"><i>R 12</i></span>
        </div>
      </div>
    </div>

    <!-- C-16 Accordion ---------------------------------------------------- -->
    <div class="cell">
      <p class="meta cell__name"><b>C-16</b> Accordion</p>
      <p class="meta cell__states">collapsed &middot; expanded &middot; hover &middot; focus</p>
      <div class="cell__body">
        <div class="an ds-acc" data-box>
          <details open>
            <summary>What governance means<span class="ds-acc__i" aria-hidden="true"></span></summary>
            <p>Ownership, a review path, and a version anyone can pin to.</p>
          </details>
          <details>
            <summary>Who decides a breaking change<span class="ds-acc__i" aria-hidden="true"></span></summary>
            <p>The system team proposes, the consumers ratify.</p>
          </details>
          <span class="dm dm--h dm--over" style="--l:0;--w:14px"><i>P 14</i></span>
        </div>
      </div>
    </div>

    <!-- C-17 Breadcrumb, avatars & row ------------------------------------ -->
    <div class="cell" id="c-17">
      <p class="meta cell__name"><b>C-17</b> Breadcrumb, avatars &amp; row</p>
      <p class="meta cell__states">default &middot; hover &middot; focus &middot; current</p>
      <div class="cell__body">
        <nav class="an an--fit ds-crumb" aria-label="Breadcrumb">
          <a href="#c-17">Systems</a>
          <s class="an">/<span class="dm dm--h dm--over" style="--l:-8px;--w:8px"><i>G 8</i></span></s>
          <a href="#c-17">Tokens</a>
          <s>/</s>
          <b aria-current="page">Spacing</b>
        </nav>
        <div class="an an--fit ds-stack-a">
          <span class="ds-av an">JC<span class="dm dm--h dm--over" style="--w:100%"><i>W 28</i></span></span>
          <span class="ds-av">MR</span>
          <span class="ds-av">AL</span>
          <span class="ds-av ds-av--more">+4</span>
        </div>
        <a class="an an--fit ds-row" href="#c-17">
          <span class="ds-avatar">JC</span>
          <span class="ds-row__text"><b>Jordi Catal&aacute;n</b><span class="ds-meta">Design Ops</span></span>
          <span class="dm dm--h dm--over" style="--l:0;--w:36px"><i>W 36</i></span>
        </a>
      </div>
    </div>

    <!-- C-18 Empty, loading & skeleton ------------------------------------ -->
    <div class="cell">
      <p class="meta cell__name"><b>C-18</b> Empty, loading &amp; skeleton</p>
      <p class="meta cell__states">loading &middot; empty &middot; hover &middot; focus</p>
      <div class="cell__body">
        <div class="an ds-empty" data-box>
          <span class="ds-spin" aria-hidden="true"></span>
          <p>No components match that filter.</p>
          <Button variant="ghost" size="sm">Clear filter</Button>
          <span class="cl cl--right" style="--t:20px"><i>R 8</i></span>
        </div>
        <div class="an ds-skel">
          <span class="ds-skel__l an" style="width:100%"><span class="cl cl--right" style="--t:50%"><i>H 12</i></span></span>
          <span class="ds-skel__l" style="width:64%"></span>
          <span class="dm dm--v dm--left" style="--t:20px;--h:8px"><i>G 8</i></span>
        </div>
      </div>
    </div>
  </div>

  <!-- The foot carries the key and the scales the board is actually built on,
       so the numbers above resolve to a system rather than floating free. -->
  <div class="board__foot">
    <p class="meta board__hint">{b.hint}</p>
    <dl class="strip">
      <div><dt class="meta">{b.key}</dt><dd class="meta" set:html={b.keyValue}></dd></div>
      <div><dt class="meta">{b.space}</dt><dd class="meta"><span>4<b>space-1</b></span><span>8<b>space-2</b></span><span>12<b>space-3</b></span><span>16<b>space-4</b></span><span>20<b>space-5</b></span><span>24<b>space-6</b></span></dd></div>
      <div><dt class="meta">{b.radius}</dt><dd class="meta"><span>4<b>xs</b></span><span>6<b>sm</b></span><span>8<b>md</b></span><span>12<b>lg</b></span><span>999<b>full</b></span></dd></div>
      <div><dt class="meta">{b.type}</dt><dd class="meta"><span>11<b>xs</b></span><span>12<b>sm</b></span><span>13<b>base</b></span><span>14<b>md</b></span><span>16<b>lg</b></span></dd></div>
      <div><dt class="meta">{b.colour}</dt><dd class="meta swatches">
        <span><em style="--c:var(--ink)"></em>ink</span>
        <span><em style="--c:var(--ink-2)"></em>ink-2</span>
        <span><em style="--c:var(--ink-3)"></em>ink-3</span>
        <span><em style="--c:var(--mark)"></em>mark</span>
        <span><em style="--c:var(--rule)"></em>rule</span>
        <span><em style="--c:var(--paper)"></em>paper</span>
        <span><em style="--c:var(--ok)"></em>ok</span>
        <span><em style="--c:var(--warn)"></em>warn</span>
        <span><em style="--c:var(--bad)"></em>bad</span>
      </dd></div>
      <div><dt class="meta">{b.legend}</dt><dd class="meta">{b.unitsValue}</dd></div>
    </dl>
  </div>
</section>

<style>
  /* =====================================================================
     The board. The site's thesis, shown rather than claimed: a component
     library that can be read as design or as specification.

     The components are native elements, so every state is the browser's own:
     :hover, :focus-visible, :active, :checked, [open], :disabled. Nothing here
     needs script, and nothing fakes a state with a class.

     Every number in an annotation is the number the CSS actually sets, so the
     spec view is true rather than decorative.
     ===================================================================== */

  .board {
    /* Redline ink. Deliberately not a product token: the drawing is not part
       of the thing being drawn. 5.3:1 on the panel. */
    --spec: #cb008e;

    /* Semantic colours, which a component library needs and a portfolio does
       not. All four clear AA on the panel. */
    --ok: #0f7a4a;
    --warn: #a05a00;
    --bad: #c02626;

    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--rule);
    background: var(--panel);
  }

  .board__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem 1.25rem;
    flex-wrap: wrap;
    padding: 0.75rem clamp(0.85rem, 2vw, 1.25rem);
    border-bottom: 1px solid var(--rule);
  }

  .board__label { color: var(--ink); }
  .board__live { color: var(--ink-3); }

  .seg {
    margin-left: auto;
    display: flex;
    padding: 3px;
    gap: 2px;
    border: 1px solid var(--rule);
    border-radius: var(--r-pill);
    background: var(--paper);
  }

  .seg__opt {
    display: flex;
    align-items: center;
    padding: 0.4rem 0.8rem;
    border-radius: var(--r-pill);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    font-weight: 500;
    color: var(--ink-3);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .seg__opt:hover { color: var(--ink); }

  /* Cells draw their own right and bottom hairline instead of showing a gap
     colour through 1px gutters. That way a part-filled last row is just
     unused paper, and the board tiles at any number of cells. */
  .board__grid {
    display: grid;
    gap: 0;
    background: var(--panel);
  }

  @media (min-width: 760px) { .board__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1120px) { .board__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1460px) { .board__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .cell {
    background: var(--panel);
    box-shadow: inset -1px -1px 0 var(--rule-2);
    /* A grid item's default minimum is its min-content, which lets one wide
       component push the cell past its track — and the body's overflow clip
       would hide that rather than fix it. */
    min-width: 0;
    padding: clamp(1rem, 2vw, 1.5rem) clamp(0.85rem, 1.6vw, 1.25rem);
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .cell__name { color: var(--ink-3); }
  .cell__name b { color: var(--spec); font-weight: 500; }
  /* The two cells that are not a demonstration: these are the site's own
     components — .btn and .tag in global.css, rendered here through the same
     ui/Button.astro and ui/Tag.astro the header CTA and the 404 page use. */
  .cell__used {
    margin-left: 8px;
    padding: 2px 6px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--mark) 10%, transparent);
    color: var(--mark);
    letter-spacing: 0.08em;
  }

  .cell__states { color: var(--ink-3); opacity: 0.75; font-size: 0.5625rem; }

  /* The body reserves the margins the dimension lines hang in: a left rail
     for heights, a right rail for callout labels, and slack above and below
     for the horizontal dimensions. Reserved in both modes, so nothing moves
     when the switch is thrown. */
  .cell__body {
    display: grid;
    gap: 42px;
    padding: 20px 68px 24px 42px;
    margin-top: 0.4rem;
  }

  /* The anchor for every annotation: it hugs the component it wraps, so a
     dimension line set to 100% measures the component itself.

     It must never carry a border of its own: a percentage on an absolutely
     positioned child resolves against the padding box, so a bordered anchor
     makes every 100% line come up two pixels short of the number it prints. */
  .an { position: relative; width: 100%; }
  .an--fit { width: fit-content; max-width: 100%; justify-self: start; }

  .row { display: flex; align-items: center; }

  /* --- Shared interaction ------------------------------------------------ */

  /* Hover only where there is a pointer that hovers: on a touch screen the
     state sticks after a tap and the component lies about what it is doing. */
  .cell :focus-visible { outline: 2px solid var(--mark); outline-offset: 2px; }

  .ds-chip,
  .ds-chip__x,
  .ds-tab,
  .ds-field,
  .ds-area,
  .ds-menu__item,
  .ds-seg__o,
  .ds-pager__b,
  .ds-card,
  .ds-row,
  .ds-toast__u,
  .ds-toast__x,
  .ds-crumb a,
  .ds-acc summary,
  .ds-dialog summary {
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  /* C-01 Button and C-02 Tag are .btn / .tag in global.css: the board draws
     the site's own pieces, so only the chip below is board-local. */

  .ds-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding: 0 4px 0 10px;
    border-radius: 999px;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--rule);
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-2);
    white-space: nowrap;
  }

  .ds-chip__x {
    width: 18px;
    height: 18px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-3);
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
  }

  @media (hover: hover) {
    .ds-chip:hover { box-shadow: inset 0 0 0 1px var(--ink-3); }
    .ds-chip__x:hover { background: var(--ink); color: var(--paper); }
  }

  .ds-chip__x:active { transform: scale(0.92); }

  /* --- C-03 Tabs --------------------------------------------------------- */

  .ds-tabs { display: flex; gap: 24px; border-bottom: 1px solid var(--rule-2); }

  .ds-tab {
    padding-bottom: 10px;
    font-size: 13px;
    line-height: 1;
    color: var(--ink-3);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    white-space: nowrap;
    cursor: pointer;
  }

  @media (hover: hover) { .ds-tab:hover { color: var(--ink); } }

  #ds-tab-1:checked ~ [for='ds-tab-1'],
  #ds-tab-2:checked ~ [for='ds-tab-2'],
  #ds-tab-3:checked ~ [for='ds-tab-3'] {
    color: var(--ink);
    border-bottom-color: var(--mark);
    font-weight: 500;
  }

  /* The input is off-screen, so the label it controls shows the focus ring. */
  #ds-tab-1:focus-visible ~ [for='ds-tab-1'],
  #ds-tab-2:focus-visible ~ [for='ds-tab-2'],
  #ds-tab-3:focus-visible ~ [for='ds-tab-3'],
  #ds-th-1:focus-visible ~ [for='ds-th-1'],
  #ds-th-2:focus-visible ~ [for='ds-th-2'],
  #ds-pg-1:focus-visible ~ [for='ds-pg-1'],
  #ds-pg-2:focus-visible ~ [for='ds-pg-2'],
  #ds-pg-3:focus-visible ~ [for='ds-pg-3'] {
    outline: 2px solid var(--mark);
    outline-offset: 2px;
  }

  /* --- C-04/05 Fields ---------------------------------------------------- */

  .ds-lab { display: block; font-size: 12px; font-weight: 500; color: var(--ink-2); margin-bottom: 8px; }

  .ds-field {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
    height: 44px;
    padding-inline: 16px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--paper);
    font: inherit;
    font-size: 14px;
    color: var(--ink);
  }

  .ds-field--bad { border-color: var(--bad); }
  .ds-err { margin-top: 6px; font-size: 11px; color: var(--bad); }

  .ds-area {
    display: block;
    width: 100%;
    padding: 12px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--paper);
    font: inherit;
    font-size: 13px;
    color: var(--ink);
    resize: vertical;
    min-height: 76px;
  }

  @media (hover: hover) {
    .ds-field:hover,
    .ds-area:hover { border-color: var(--ink-3); }
  }

  .ds-field:focus,
  .ds-area:focus {
    outline: 0;
    border-color: var(--mark);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--mark) 18%, transparent);
  }

  /* --- C-06 Dropdown ----------------------------------------------------- */

  .ds-drop summary { cursor: pointer; list-style: none; }
  .ds-drop summary::-webkit-details-marker { display: none; }
  .ds-drop summary svg { transition: transform var(--dur-fast) var(--ease); }
  .ds-drop[open] summary svg { transform: rotate(180deg); }
  .ds-drop[open] summary { border-color: var(--ink-3); }

  .ds-menu {
    margin-top: 4px;
    padding: 4px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--panel);
    display: grid;
  }

  .ds-menu__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    height: 34px;
    padding-inline: 10px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    font: inherit;
    font-size: 13px;
    color: var(--ink-2);
    text-align: left;
    cursor: pointer;
  }

  @media (hover: hover) { .ds-menu__item:hover { background: var(--paper); color: var(--ink); } }
  .ds-menu__item.is-on { background: var(--paper); color: var(--mark); font-weight: 500; }

  /* --- C-07 Selection ---------------------------------------------------- */

  .ds-stack { display: grid; gap: 12px; }

  .ds-choice {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    line-height: 19px;
    cursor: pointer;
  }

  .ds-radio,
  .ds-check,
  .ds-switch {
    appearance: none;
    margin: 0;
    flex: none;
    background: var(--paper);
    border: 1px solid var(--rule);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .ds-radio { width: 18px; height: 18px; border-radius: 50%; }

  /* The inner dot is a ring, so it needs no extra element. */
  .ds-radio:checked {
    border-color: var(--mark);
    box-shadow: inset 0 0 0 4px var(--panel), inset 0 0 0 9px var(--mark);
  }

  .ds-check {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    display: grid;
    place-content: center;
  }

  .ds-check::after {
    content: '';
    width: 9px;
    height: 5px;
    border: 2px solid var(--paper);
    border-top: 0;
    border-right: 0;
    transform: rotate(-45deg) translate(1px, -1px);
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease);
  }

  .ds-check:checked { background: var(--mark); border-color: var(--mark); }
  .ds-check:checked::after { opacity: 1; }

  .ds-switch { width: 40px; height: 22px; border-radius: 999px; position: relative; border-color: var(--rule); background: var(--rule); }

  .ds-switch::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--panel);
    transition: left var(--dur-fast) var(--ease);
  }

  .ds-switch:checked { background: var(--mark); border-color: var(--mark); }
  .ds-switch:checked::after { left: 20px; }

  @media (hover: hover) {
    .ds-radio:hover,
    .ds-check:hover,
    .ds-switch:hover { border-color: var(--ink-3); }
  }

  /* --- C-08 Search & segmented ------------------------------------------- */

  .ds-search {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding-inline: 12px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--paper);
    transition: border-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
  }

  .ds-search svg { flex: none; color: var(--ink-3); }

  .ds-search input {
    min-width: 0;
    flex: 1;
    border: 0;
    background: none;
    font: inherit;
    font-size: 13px;
    color: var(--ink);
  }

  .ds-search input:focus { outline: 0; }

  @media (hover: hover) { .ds-search:hover { border-color: var(--ink-3); } }

  /* The ring belongs to the field, not to the bare input inside it. */
  .ds-search:focus-within {
    border-color: var(--mark);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--mark) 18%, transparent);
  }

  .ds-search:focus-within input:focus-visible { outline: 0; }

  .ds-seg {
    display: flex;
    gap: 2px;
    padding: 3px;
    height: 36px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper);
  }

  .ds-seg__o {
    display: flex;
    align-items: center;
    padding-inline: 12px;
    border-radius: 999px;
    font-size: 12px;
    color: var(--ink-3);
    white-space: nowrap;
    cursor: pointer;
  }

  @media (hover: hover) { .ds-seg__o:hover { color: var(--ink); } }

  #ds-th-1:checked ~ [for='ds-th-1'],
  #ds-th-2:checked ~ [for='ds-th-2'] {
    background: var(--panel);
    color: var(--ink);
    font-weight: 500;
  }

  /* --- C-09 Slider & progress -------------------------------------------- */

  .ds-range {
    appearance: none;
    flex: 1;
    min-width: 0;
    height: 16px;
    background: none;
    cursor: pointer;
  }

  /* Track and thumb have to be declared once per engine; there is no
     shorthand that both understand. */
  .ds-range::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 999px;
    background: var(--rule);
  }

  .ds-range::-moz-range-track {
    height: 4px;
    border-radius: 999px;
    background: var(--rule);
  }

  .ds-range::-webkit-slider-thumb {
    appearance: none;
    width: 16px;
    height: 16px;
    margin-top: -6px;
    border-radius: 50%;
    background: var(--panel);
    box-shadow: 0 0 0 1px var(--mark);
    transition: box-shadow var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }

  .ds-range::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: 0;
    border-radius: 50%;
    background: var(--panel);
    box-shadow: 0 0 0 1px var(--mark);
  }

  .ds-range::-moz-range-progress { height: 4px; border-radius: 999px; background: var(--mark); }

  @media (hover: hover) {
    .ds-range:hover::-webkit-slider-thumb { box-shadow: 0 0 0 2px var(--mark); }
  }

  .ds-range:active::-webkit-slider-thumb { transform: scale(1.15); }
  .ds-range:focus-visible { outline: 0; }
  .ds-range:focus-visible::-webkit-slider-thumb { box-shadow: 0 0 0 2px var(--mark), 0 0 0 5px color-mix(in srgb, var(--mark) 22%, transparent); }
  .ds-range:focus-visible::-moz-range-thumb { box-shadow: 0 0 0 2px var(--mark), 0 0 0 5px color-mix(in srgb, var(--mark) 22%, transparent); }

  .ds-prog { display: block; height: 6px; border-radius: 999px; background: var(--rule); }
  .ds-prog__fill { display: block; width: 40%; height: 100%; border-radius: 999px; background: var(--mark); }

  /* --- C-10 Stepper & pagination ----------------------------------------- */

  .ds-steps { display: flex; align-items: center; gap: 0; }

  .ds-step {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--rule);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-3);
    flex: none;
  }

  .ds-step.is-done { background: var(--mark); border-color: var(--mark); color: #fff; }
  .ds-step.is-on { border-color: var(--mark); color: var(--mark); box-shadow: 0 0 0 3px color-mix(in srgb, var(--mark) 14%, transparent); }
  .ds-step__line { width: 24px; height: 1px; background: var(--rule); flex: none; }

  .ds-pager { display: flex; align-items: center; gap: 4px; }

  .ds-pager__b {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid var(--rule);
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    font: inherit;
    font-size: 12px;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }

  @media (hover: hover) { .ds-pager__b:hover { border-color: var(--ink); color: var(--ink); } }
  .ds-pager__b:active { transform: translateY(1px); }

  #ds-pg-1:checked ~ [for='ds-pg-1'],
  #ds-pg-2:checked ~ [for='ds-pg-2'],
  #ds-pg-3:checked ~ [for='ds-pg-3'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  /* --- C-11 Card --------------------------------------------------------- */

  .ds-card {
    display: grid;
    gap: 8px;
    justify-items: start;
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 20px;
    background: var(--paper);
    color: inherit;
    text-decoration: none;
  }

  .ds-card__title { font-size: 16px; font-weight: 500; letter-spacing: -0.02em; }
  .ds-card__text { font-size: 13px; color: var(--ink-2); }

  .ds-card__foot {
    margin-top: 4px;
    padding-top: 12px;
    border-top: 1px solid var(--rule-2);
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ds-meta { font-size: 11px; color: var(--ink-3); font-variant-numeric: tabular-nums; }

  .ds-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 500;
    color: var(--mark);
  }

  .ds-link svg { transition: transform var(--dur-fast) var(--ease); }

  @media (hover: hover) {
    .ds-card:hover { border-color: var(--ink); background: var(--panel); }
    .ds-card:hover .ds-link svg { transform: translate(2px, -2px); }
  }

  /* --- C-12 Table -------------------------------------------------------- */

  .ds-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid var(--rule);
    border-radius: 8px;
    overflow: hidden;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .ds-table th,
  .ds-table td {
    padding-inline: 12px;
    text-align: left;
    font-weight: 400;
  }

  .ds-table td:last-child,
  .ds-table th:last-child { text-align: right; }

  .ds-table th {
    height: 32px;
    background: var(--paper);
    color: var(--ink-3);
    font-weight: 500;
  }

  .ds-table td { height: 36px; border-top: 1px solid var(--rule-2); }

  @media (hover: hover) { .ds-table tbody tr:hover td { background: var(--paper); } }

  /* --- C-13 Alerts ------------------------------------------------------- */

  .ds-alerts { display: grid; gap: 8px; }

  .ds-alert {
    padding: 12px;
    border: 1px solid var(--rule);
    border-left: 2px solid var(--tone, var(--mark));
    border-radius: 8px;
    background: var(--paper);
    font-size: 12px;
    color: var(--ink-2);
  }

  .ds-alert b { color: var(--tone, var(--mark)); font-weight: 500; }

  .ds-alert--info { --tone: var(--mark); }
  .ds-alert--ok { --tone: var(--ok); }
  .ds-alert--warn { --tone: var(--warn); }
  .ds-alert--bad { --tone: var(--bad); }

  /* --- C-14 Tooltip & toast ---------------------------------------------- */

  .ds-tipwrap { position: relative; }

  .ds-tip__trigger { position: relative; cursor: pointer; }

  .ds-tip {
    position: absolute;
    left: 0;
    bottom: calc(100% + 8px);
    padding: 8px 10px;
    border-radius: 6px;
    background: var(--ink);
    color: var(--paper);
    font-size: 12px;
    font-weight: 400;
    width: max-content;
    max-width: 13ch;
    opacity: 0;
    transform: translateY(3px);
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }

  .ds-tip::after {
