  /* --- Annotations ------------------------------------------------------- */

  /* Two primitives carry every measurement: a dimension line with end ticks,
     and a callout with a leader. Both are hidden until the switch says Specs,
     and neither takes pointer events, so the board reads the same either way. */
  .dm,
  .cl {
    position: absolute;
    color: var(--mark);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease);
  }

  .dm i,
  .cl i {
    position: absolute;
    font-style: normal;
    font-size: 0.625rem;
    line-height: 1;
    font-weight: 500;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    background: var(--panel);
    padding: 1px 3px;
    white-space: nowrap;
  }

  /* Horizontal: a width. Anchored to the component's left edge by --l. */
  .dm--h {
    left: var(--l, 0);
    width: var(--w, 100%);
    height: 1px;
    background: currentColor;
  }

  .dm--h::before,
  .dm--h::after {
    content: '';
    position: absolute;
    top: -3px;
    width: 1px;
    height: 7px;
    background: currentColor;
  }

  .dm--h::before { left: 0; }
  .dm--h::after { right: 0; }

  /* Above the component, label above the line; below it, label below — so a
     dimension never prints its number on top of the thing it measures. */
  .dm--over { top: -11px; }
  .dm--over i { left: 50%; bottom: 4px; transform: translateX(-50%); }
  .dm--under { top: calc(100% + 11px); }
  .dm--under i { left: 50%; top: 4px; transform: translateX(-50%); }

  /* Vertical: a height. --h 100% measures the whole component. Top and bottom
     must not both be auto, or the line falls to its static position — below
     the component instead of beside it. */
  .dm--v {
    top: var(--t, 0);
    bottom: var(--b, auto);
    width: 1px;
    height: var(--h, 100%);
    background: currentColor;
  }

  .dm--v::before,
  .dm--v::after {
    content: '';
    position: absolute;
    left: -3px;
    width: 7px;
    height: 1px;
    background: currentColor;
  }

  .dm--v::before { top: 0; }
  .dm--v::after { bottom: 0; }

  .dm--left { left: -16px; }
  .dm--left i { top: 50%; right: 6px; transform: translateY(-50%); }
  .dm--right { right: -16px; }
  .dm--right i { top: 50%; left: 6px; transform: translateY(-50%); }

  /* Callout: a leader off an edge, for radii and border widths. */
  .cl {
    left: 100%;
    top: var(--t, 0);
    width: 12px;
    height: 1px;
    background: currentColor;
  }

  .cl::before {
    content: '';
    position: absolute;
    left: -1px;
    top: -1.5px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
  }

  .cl--right i { left: 16px; top: 50%; transform: translateY(-50%); }

  /* Mirrored, for a detail that sits at the component's left edge. */
  .cl--left { left: auto; right: 100%; }
  .cl--left::before { left: auto; right: -1px; }
  .cl--left i { right: 16px; top: 50%; transform: translateY(-50%); }

  /* --- The foot: key and scales ------------------------------------------ */

  .board__foot {
    padding: 0.75rem clamp(0.85rem, 2vw, 1.25rem);
    border-top: 1px solid var(--rule);
    display: grid;
  }

  /* Both live in the same grid cell, so swapping them changes no height and
     nothing below the board moves when the switch is thrown. */
  .board__hint,
  .strip { grid-area: 1 / 1; transition: opacity var(--dur-fast) var(--ease); }

  .strip {
    margin: 0;
    opacity: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.75rem;
    align-items: baseline;
  }

  .strip > div { display: flex; align-items: baseline; gap: 0.5rem; }
  .strip dt { color: var(--ink); }
  .strip dd { margin: 0; color: var(--ink-3); display: flex; flex-wrap: wrap; gap: 0.2rem 0.75rem; }

  /* A value and the token that names it, read as one unit. */
  .strip dd > span { display: inline-flex; align-items: baseline; gap: 0.3rem; }
  .strip dd b { color: var(--ink-2); font-weight: 500; text-transform: none; letter-spacing: 0.04em; }

  /* Colour tokens carry their own sample, outlined so paper stays visible. */
  .strip em,
  .cl i em {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--c);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 25%, transparent);
    flex: none;
  }

  .swatches > span { gap: 0.35rem; }

  .cl i {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* --- The switch -------------------------------------------------------- */

  /* Sibling selectors, so the whole thing runs on CSS. The inputs are the
     first children of .board for exactly this reason. */
  #ds-design:checked ~ .board__bar .seg__opt[for='ds-design'],
  #ds-specs:checked ~ .board__bar .seg__opt[for='ds-specs'] {
    background: var(--ink);
    color: var(--paper);
  }

  #ds-specs:checked ~ .board__grid .dm,
  #ds-specs:checked ~ .board__grid .cl { opacity: 1; }

  /* In Specs the components' own boxes are drawn, the way a redline does. */
  #ds-specs:checked ~ .board__grid [data-box] {
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--mark) 40%, transparent);
  }

  #ds-specs:checked ~ .board__foot .board__hint { opacity: 0; }
  #ds-specs:checked ~ .board__foot .strip { opacity: 1; }

  /* Keyboard focus lands on the radio, which is off-screen — so the label it
     controls has to show the ring on its behalf. */
  #ds-design.board__radio:focus-visible ~ .board__bar .seg__opt[for='ds-design'],
  #ds-specs.board__radio:focus-visible ~ .board__bar .seg__opt[for='ds-specs'] {
    outline: 2px solid var(--mark);
    outline-offset: 2px;
  }

  /* Phones. Six cells stacked in one column ran to nearly 2000px, which is no
     way to open a page — so the library becomes a snapped horizontal scroller
     instead. One cell at a time, the next one peeking as the affordance, and
     the whole board back to roughly the height of a single card.

     The scroller is contained: overscroll-behavior stops a swipe chaining to
     the page, and the region is focusable so a keyboard can pan it too. */
  @media (max-width: 619px) {
    .board__bar { align-items: flex-start; }
    .seg { margin-left: 0; }

    .board__grid {
      grid-auto-flow: column;
      grid-auto-columns: 90%;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .board__grid::-webkit-scrollbar { display: none; }

    .cell {
      scroll-snap-align: start;
      grid-template-rows: auto 1fr;
      align-content: stretch;
    }

    .cell__body { align-content: center; }

    /* The left rail has to clear a label like "H 40" at its 16px offset. */
    .cell__body { gap: 34px; padding: 18px 52px 22px 44px; }

    /* Seven wrapped lines of legend ate a third of the board. It becomes a
       single swipeable row instead — the same gesture as the cells above it. */
    .strip {
      flex-wrap: nowrap;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      gap: 0 1.5rem;
    }

    .strip::-webkit-scrollbar { display: none; }
    .strip > div { flex: none; }
    .strip dd { flex-wrap: nowrap; white-space: nowrap; }

  }
