---
import { readdirSync } from 'node:fs';
import { extname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { imageSize } from '../lib/imageSize';
import { ui } from '../data/site';
import { cases, type CaseStudy } from '../data/cases';
import { langPrefix, type Lang } from '../data/types';
import Icon from './Icon.astro';

interface Props { lang: Lang; study: CaseStudy }
const { lang, study } = Astro.props;
const base = langPrefix(lang);

const index = cases.findIndex((c) => c.slug === study.slug);
const next = cases[(index + 1) % cases.length];

const labels = {
  en: { problem: 'The problem', solution: 'The solution', highlights: 'Highlights' },
  es: { problem: 'El problema', solution: 'La solución', highlights: 'Lo más relevante' },
}[lang];

/* Images are matched by NAME, not by extension: whatever format a screenshot
   happened to be exported in, dropping it into public/cases/ is enough. Slots
   with no matching file are dropped at build time, so a slot can be declared
   before its file exists without leaving a broken <img>. */
const CASE_DIR = fileURLToPath(new URL('../../public/cases/', import.meta.url));

let onDisk: string[] = [];
try {
  onDisk = readdirSync(CASE_DIR);
} catch {
  onDisk = [];
}

const stem = (name: string) => name.replace(/\.[^.]+$/, '').toLowerCase();

/* Order only matters when one name exists in several formats — then every
   build has to pick the same one. */
const BY_FORMAT = ['.avif', '.webp', '.png', '.jpg', '.jpeg', '.gif', '.svg'];
const rank = (file: string) => {
  const i = BY_FORMAT.indexOf(extname(file).toLowerCase());
  return i === -1 ? BY_FORMAT.length : i;
};

const resolve = (name: string) =>
  onDisk
    .filter((file) => stem(file) === stem(name))
    .sort((a, b) => rank(a) - rank(b))[0];

/* Intrinsic dimensions go on the tag so the browser reserves the right space
   before the bytes arrive, instead of shoving the text down as each one
   lands. An unreadable header just leaves the attributes off. */
const present = study.images
  .map((image) => {
    const file = resolve(image.src);
    return file ? { ...image, file, size: imageSize(join(CASE_DIR, file)) } : undefined;
  })
  .filter((image): image is NonNullable<typeof image> => Boolean(image));

const wide = present.filter((i) => i.span !== 'half');
const half = present.filter((i) => i.span === 'half');

/* The first wide image opens the case; the rest are dealt out between the
   narrative sections so a long set never stacks into a wall of pictures
   ahead of the text. Any left over trail the last section. */
const [lead, ...spread] = wide;
const afterSection = (n: number) => (n < spread.length ? spread[n] : undefined);
const trailing = spread.slice(study.sections.length);
---

<article class="case">
  <!-- Masthead --------------------------------------------------------- -->
  <header class="case__top">
    <div class="shell">
      <p class="meta meta--mark case__company" data-reveal>{study.company}</p>
      <h1 class="h2 case__title" data-reveal style="--reveal-delay:60ms">{study.tagline[lang]}</h1>

      <dl class="case__meta" data-reveal style="--reveal-delay:140ms">
        <div>
          <dt class="meta">{ui[lang].role}</dt>
          <dd>{study.role[lang]}</dd>
        </div>
        <div>
          <dt class="meta">{ui[lang].period}</dt>
          <dd>{study.period[lang]}</dd>
        </div>
        <div>
          <dt class="meta">{ui[lang].company}</dt>
          <dd>{study.company}</dd>
        </div>
      </dl>
    </div>
  </header>

  <!-- Problem / solution ------------------------------------------------ -->
  <section class="case__pair">
    <div class="shell case__pairGrid">
      <div class="case__pairCol" data-reveal>
        <p class="meta">{labels.problem}</p>
        <p class="case__pairText">{study.problem[lang]}</p>
      </div>
      <div class="case__pairCol" data-reveal style="--reveal-delay:90ms">
        <p class="meta">{labels.solution}</p>
        <p class="case__pairText">{study.solution[lang]}</p>
      </div>
    </div>
  </section>

  <!-- Lead image ---------------------------------------------------------- -->
  {lead && (
    <section class="case__media">
      <div class="shell">
        <figure class="case__figure" data-reveal>
          <img
              src={`/cases/${lead.file}`}
              alt={lead.alt[lang]}
              width={lead.size?.width}
              height={lead.size?.height}
              loading="lazy"
              decoding="async"
            />
          {lead.caption && <figcaption>{lead.caption[lang]}</figcaption>}
        </figure>
      </div>
    </section>
  )}

  <!-- Narrative ---------------------------------------------------------- -->
  <section class="case__body">
    <div class="shell">
      {study.sections.map((s, i) => {
        const follows = afterSection(i);
        return (
          <>
            <div class="rows case__section">
              <p class="meta" data-reveal>{s.title[lang]}</p>
              <div class="case__sectionText prose-col">
                {s.body[lang].map((para, n) => (
                  <p data-reveal style={`--reveal-delay:${n * 80}ms`}>{para}</p>
                ))}
              </div>
            </div>

            {follows && (
              <figure class="case__figure case__figure--inline" data-reveal>
                <img
              src={`/cases/${follows.file}`}
              alt={follows.alt[lang]}
              width={follows.size?.width}
              height={follows.size?.height}
              loading="lazy"
              decoding="async"
            />
                {follows.caption && <figcaption>{follows.caption[lang]}</figcaption>}
              </figure>
            )}
          </>
        );
      })}

      {trailing.map((img) => (
        <figure class="case__figure case__figure--inline" data-reveal>
          <img
              src={`/cases/${img.file}`}
              alt={img.alt[lang]}
              width={img.size?.width}
              height={img.size?.height}
              loading="lazy"
              decoding="async"
            />
          {img.caption && <figcaption>{img.caption[lang]}</figcaption>}
        </figure>
      ))}

      {half.length > 0 && (
        <div class="case__pairMedia">
          {half.map((img) => (
            <figure class="case__figure" data-reveal>
              <img
              src={`/cases/${img.file}`}
              alt={img.alt[lang]}
              width={img.size?.width}
              height={img.size?.height}
              loading="lazy"
              decoding="async"
            />
              {img.caption && <figcaption>{img.caption[lang]}</figcaption>}
            </figure>
          ))}
        </div>
      )}

      <div class="rows case__section">
        <p class="meta" data-reveal>{labels.highlights}</p>
        <ul class="case__wins prose-col">
          {study.achievements[lang].map((a, n) => (
            <li data-reveal style={`--reveal-delay:${Math.min(n, 4) * 70}ms`}>{a}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Next --------------------------------------------------------------- -->
  <section class="case__next">
    <div class="shell">
      <a class="nextcard" href={`${base}/work/${next.slug}/`}>
        <span class="meta">{ui[lang].nextCase}</span>
        <span class="nextcard__row">
          <span class="h2 nextcard__name">{next.company}</span>
          <Icon name="arrow-up-right" size={28} class="nextcard__arrow" />
        </span>
        <span class="nextcard__role">{next.role[lang]}</span>
      </a>
    </div>
  </section>
</article>

<style>
  /* --- Masthead ------------------------------------------------------------ */

  /* The case opens on the same paper as the home page and states its facts
     before it shows anything, the way a drawing carries a title block. */
  .case__top {
    padding-block: clamp(6.5rem, 12vw, 9rem) clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--ink);
  }

  .case__top > .shell { display: grid; gap: clamp(1.1rem, 2.2vw, 1.75rem); }

  .case__title { max-width: 22ch; }

  /* On the rig, like every other column on the site: two of the four narrow
     columns, two of eight, three of twelve — so each fact starts on a line. */
  .case__meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem 0;
    margin: 0;
    padding-top: clamp(0.75rem, 2vw, 1.5rem);
    border-top: 1px solid var(--rule);
  }

  .case__meta > div { grid-column: span 2; padding-right: var(--col-pad); }

  @media (min-width: 700px) {
    .case__meta { grid-template-columns: repeat(8, minmax(0, 1fr)); }
  }

  @media (min-width: 1100px) {
    .case__meta { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .case__meta > div { grid-column: span 3; }
  }

  .case__meta dt { margin-bottom: 0.3rem; }
  .case__meta dd { margin: 0; }

  /* --- Problem / solution -------------------------------------------------- */

  .case__pair { padding-block: var(--section-y); }

  .case__pairGrid { display: grid; gap: clamp(2rem, 4vw, 4rem) 0; }

  @media (min-width: 820px) {
    .case__pairGrid { grid-template-columns: repeat(8, minmax(0, 1fr)); }
    .case__pairCol { grid-column: span 4; padding-right: var(--col-pad); }
  }

  @media (min-width: 1100px) {
    .case__pairGrid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .case__pairCol { grid-column: span 6; }
  }

  .case__pairCol { display: grid; gap: 0.85rem; align-content: start; }

  .case__pairText {
    font-size: var(--fs-body);
    line-height: 1.6;
    max-width: 48ch;
  }

  /* --- Media --------------------------------------------------------------- */

  .case__media { padding-bottom: clamp(2.5rem, 5vw, 4rem); }

  .case__figure { margin: 0; display: grid; gap: 0.7rem; }

  /* Sits between narrative sections, so it needs the rhythm the sections have. */
  .case__figure--inline { margin: clamp(2rem, 5vw, 3.5rem) 0; }

  .case__figure img {
    width: 100%;
    /* The width/height attributes give the intrinsic ratio; this keeps them
       from fixing the rendered height. */
    height: auto;
    border: 1px solid var(--rule);
    background: var(--panel);
  }

  .case__figure figcaption {
    font-size: var(--fs-meta);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .case__pairMedia {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    padding-block: clamp(1rem, 3vw, 2.5rem);
  }

  @media (min-width: 720px) {
    .case__pairMedia { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Two figures side by side land on the half line at every rig width, so the
     pair only needs its gap taken from inside the left one. */
  @media (min-width: 1100px) {
    .case__pairMedia { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0; }
    .case__pairMedia > * { grid-column: span 6; }
    .case__pairMedia > :first-child { padding-right: var(--col-pad); }
  }

  /* --- Narrative ----------------------------------------------------------- */

  .case__body { padding-bottom: var(--section-y); }

  .case__section { padding-block: clamp(1.75rem, 3.5vw, 2.75rem); }
  .case__section + .case__section { border-top: 1px solid var(--rule-2); }

  .case__sectionText { display: grid; gap: 1.1rem; color: var(--ink-2); }
  .case__sectionText p { font-size: var(--fs-body); }

  .case__wins { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.8rem; }

  .case__wins li {
    position: relative;
    padding-left: 1.6rem;
    color: var(--ink-2);
  }

  /* A hairline dash instead of a bullet — the same rule the page is drawn in. */
  .case__wins li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 10px;
    height: 1px;
    background: var(--mark);
  }

  /* --- Next ---------------------------------------------------------------- */

  .case__next { padding-bottom: clamp(3rem, 6vw, 5rem); }

  .nextcard {
    display: grid;
    gap: 0.5rem;
    border: 1px solid var(--rule);
    background: var(--panel);
    padding: clamp(1.75rem, 4vw, 3rem);
    transition: border-color var(--dur-fast) var(--ease);
  }

  .nextcard:hover { border-color: var(--ink); }

  .nextcard__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nextcard:hover .nextcard__name { color: var(--mark); }

  .nextcard__arrow {
    flex: none;
    transition: transform var(--dur-fast) var(--ease);
  }

  .nextcard:hover .nextcard__arrow { transform: translate(4px, -4px); }

  .nextcard__role { font-size: var(--fs-small); color: var(--ink-2); }
</style>
