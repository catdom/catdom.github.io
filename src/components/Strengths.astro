---
import { strengthsIntro } from '../data/home';
import { strengths } from '../data/strengths';
import { ui } from '../data/site';
import Icon from './Icon.astro';
import { langPrefix, type Lang } from '../data/types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const i = strengthsIntro[lang];
---

<section class="strengths" id="strengths" data-tone="light">
  <div class="shell">
    <div class="band">
      <div class="split band__body">
        <div class="band__aside">
          <p class="eyebrow" data-reveal>{i.label}</p>
          <h2 class="h2" data-reveal style="--reveal-delay:60ms">{i.heading}</h2>
          <p class="lead" data-reveal style="--reveal-delay:120ms">{i.body}</p>
          <a
            class="pill pill--solid band__cta"
            href={`${langPrefix(lang)}#contact`}
            data-reveal
            style="--reveal-delay:180ms"
          >
            {ui[lang].contact}
          </a>
        </div>

        <ul class="cards">
          {strengths.map((s, n) => (
            <li class="card" data-reveal style={`--reveal-delay:${(n % 2) * 90}ms`}>
              <span class="card__icon"><Icon name={s.icon} size={22} /></span>
              <h3 class="h3">{s.title[lang]}</h3>
              <p>{s.body[lang]}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .strengths { padding-block: clamp(3rem, 6vw, 5rem); background: var(--paper); }

  .band {
    background: var(--lavender);
    border-radius: var(--r-band);
    --pad-x: clamp(2rem, 3.5vw, 3.5rem);
    padding: clamp(2.5rem, 5vw, 5rem) var(--pad-x);
    display: grid;
    gap: clamp(2.5rem, 4vw, 4rem);
  }

  /* The caption, title and lead now share the left column with the CTA, so
     the column reads top-down rather than being pinned to the cards' foot. */
  .band__aside {
    align-self: start;
    display: grid;
    justify-items: start;
    gap: 1rem;
  }

  .band__aside .lead { max-width: 42ch; }

  .band__cta { margin-top: 0.5rem; }

  /* Single column: the button leaves the text block and follows the last
     card, centred, so it reads as the section's closing action. */
  @media (max-width: 899px) {
    .band__body { display: grid; }
    .band__aside { display: contents; }
    .band__aside .eyebrow { order: 1; }
    .band__aside h2 { order: 2; }
    .band__aside .lead { order: 3; margin-bottom: 0.5rem; }
    .cards { order: 4; }
    .band__cta {
      order: 5;
      justify-self: center;
      margin-top: clamp(1.75rem, 5vw, 2.5rem);
    }
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1rem, 1.6vw, 1.5rem);
  }

  @media (min-width: 720px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .card {
    background: var(--paper);
    border-radius: var(--r-card);
    padding: clamp(1.5rem, 2.4vw, 2rem);
    display: grid;
    align-content: start;
    gap: 0.75rem;
    transition: transform var(--dur) var(--ease);
  }

  /* Only where there is a real pointer: on a touch screen this fires on tap
     and reads as the card jumping away from the finger. */
  @media (hover: hover) and (pointer: fine) {
    .card:hover { transform: translateY(-4px); }
  }

  .card__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 13px;
    background: var(--dark);
    color: var(--lavender);
    margin-bottom: 0.5rem;
  }

  .card p { color: var(--ink-muted); }
</style>
