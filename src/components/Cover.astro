---
import { hero, spec } from '../data/home';
import type { Lang } from '../data/types';
import Tag from './ui/Tag.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const h = hero[lang];
const rows = spec[lang];

/* The stem's last line is the one that rolls, so it takes the last delay. */
const rollDelay = 120 + h.stem.length * 100;
---

<header class="cover">
  <!-- The background figure. Decoration only: it carries no meaning, takes no
       pointer events and is hidden from assistive tech. -->
  <canvas class="cover__field" data-field aria-hidden="true"></canvas>

  <div class="shell">
    <p class="meta cover__eyebrow">{h.eyebrow}</p>

    <h1 class="display cover__h1">
      {h.stem.map((line, n) => (
        <span class="cover__line"><i style={`--d:${120 + n * 100}ms`}>{line}</i></span>
      ))}

      <!-- Every phrase ships in the markup, stacked in one grid cell: the line
           keeps the width of the longest and nothing below it moves as they
           swap, and with no JavaScript the first one simply stays. -->
      <span class="cover__line">
        <i style={`--d:${rollDelay}ms`}>
          <span class="roll" data-roll>
            {h.rotating.map((phrase, n) => (
              <em class:list={['roll__p', { 'is-on': n === 0 }]}>{phrase}</em>
            ))}
          </span>
        </i>
      </span>
    </h1>


    <dl class="sheet">
      {rows.map((row, n) => (
        <div class="sheet__row" data-reveal style={`--reveal-delay:${380 + n * 90}ms`}>
          <dt class="sheet__head">
            <span class="sheet__i">{row.index}</span>
            <span class="meta">{row.term}</span>
          </dt>

          <dd class="sheet__body">
            <p class="sheet__text">{row.body}</p>

            {row.tags && (
              <ul class="sheet__tags">
                {row.tags.map((t) => (
                  <li><Tag>{t}</Tag></li>
                ))}
              </ul>
            )}

            {/* The markets, drawn as a legend: the code carries the weight and
                the country names it, the way a map key does. */}
            {row.markets && (
              <ul class="sheet__markets">
                {row.markets.map((m) => (
                  <li class="market">
                    <b class="market__code">{m.code}</b>
                    <span class="meta market__name">{m.name}</span>
                  </li>
                ))}
              </ul>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</header>

<style>
  .cover {
    position: relative;
    padding-block: clamp(7rem, 16vh, 11rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .cover__field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    -webkit-mask-image: radial-gradient(
      92% 82% at var(--fx, 72%) var(--fy, 46%),
      #000 46%,
      transparent 100%
    );
    mask-image: radial-gradient(
      92% 82% at var(--fx, 72%) var(--fy, 46%),
      #000 46%,
      transparent 100%
    );
  }

  /* The claim sits over the figure, never under it. */
  .cover > .shell { position: relative; z-index: 1; }

  .cover__eyebrow {
    display: block;
    opacity: 0;
    animation: fade 700ms var(--ease) 60ms forwards;
  }

  .cover__h1 {
    display: grid;
    margin-top: clamp(1rem, 2.5vw, 2rem);
  }

  /* Each line is a window; the text inside rises out of it on load.

     At a line-height of 0.92 the line box is shorter than the glyphs, so a
     descender falls 0.155em below it — measured, on "Design leadership" — and
     the window that makes the rise work was cutting the tails off every g and
     y. The padding grows the clip region and the negative margin gives the
     space straight back, so the lines sit exactly where they did. */
  .cover__line {
    display: block;
    overflow: hidden;
    /* Measured, not guessed: at this size the ink starts 0.10em below the top
       of the line box and the descenders fall 0.10em past its bottom. So the
       window opens 0.04em above the type — enough for an accented cap, not
       enough to show the rotating phrase still travelling through the line
       above — and closes 0.17em below it, which clears every g, y and ñ. */
    padding-top: 0.04em;
    padding-bottom: 0.17em;
    margin-top: -0.04em;
    margin-bottom: -0.17em;
  }

  .cover__line i {
    display: block;
    font-style: normal;
    transform: translateY(135%);
    animation: rise-line 900ms var(--ease) forwards;
    animation-delay: var(--d, 0ms);
  }

  /* The rolling tail. All phrases occupy the same cell, so the block below the
     headline never moves; the line is clipped by .cover__line, which is what
     makes a phrase leave through the top and the next arrive from below. */
  .roll { display: grid; }

  .roll__p {
    grid-area: 1 / 1;
    font-style: normal;
    color: var(--mark);
    transform: translateY(135%);
    opacity: 0;
    transition:
      transform 520ms var(--ease),
      opacity 300ms var(--ease);
  }

  .roll__p.is-on { transform: none; opacity: 1; }
  .roll__p.is-out { transform: translateY(-135%); opacity: 0; }

  /* Justify the stack left so a short phrase does not sit centred under a
     long one. */
  .roll { justify-items: start; }

  @keyframes rise-line { to { transform: none; } }
  @keyframes fade { to { opacity: 1; } }

  /* The two facts, drawn as two panels of a spec sheet rather than as two
     paragraphs: an indexed head above a hairline, the sentence, and then the
     evidence — the three practices as tags, the three markets as a legend. */
  .sheet {
    margin-top: clamp(2.75rem, 6vw, 4.5rem);
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule);
  }

  .sheet__row {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding: 1.15rem 0 1.35rem;
    border-bottom: 1px solid var(--rule-2);
  }

  .sheet__head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .sheet__i {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: var(--track-meta);
    color: var(--mark);
    font-variant-numeric: tabular-nums;
  }

  .sheet__body { margin: 0; display: grid; gap: 0.9rem; }

  .sheet__text {
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 34ch;
    text-wrap: pretty;
  }

  .sheet__tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .sheet__markets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
  }

  /* One hairline between codes, none on the ends: the rule belongs to the gap,
     so it is drawn as a left border on every item after the first. */
  .market {
    display: grid;
    gap: 0.1rem;
    padding-inline: 1.1rem;
  }

  .market:first-child { padding-left: 0; }
  .market + .market { border-left: 1px solid var(--rule); }

  .market__code {
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .market__name { color: var(--ink-3); }

  /* The panels sit on the rig: four columns each of the eight behind them,
     six each of the twelve, and the space between them is padding inside the
     left panel rather than a gap, so both left edges land on a hairline. */
  @media (min-width: 700px) {
    .sheet {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      column-gap: 0;
    }

    /* Both panels sit under the same top rule and over the same bottom one, so
       the pair reads as one band however unevenly they fill. */
    .sheet__row {
      grid-column: span 4;
      padding-block: 1.35rem 1.6rem;
      padding-right: var(--col-pad);
    }
  }

  @media (min-width: 1100px) {
    .sheet { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .sheet__row { grid-column: span 6; }
  }

  /* Reduced motion: everything is simply already in place. */
  @media (prefers-reduced-motion: reduce) {
    .cover__eyebrow { opacity: 1; animation: none; }
    .cover__line i { transform: none; animation: none; }
    /* The rotation is stopped in script too; this keeps the first phrase
       placed rather than transitioned into place. */
    .roll__p { transition: none; }
  }
</style>
