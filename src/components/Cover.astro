---
import { hero, spec } from '../data/home';
import type { Lang } from '../data/types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const h = hero[lang];
const rows = spec[lang];

/* The stem's last line is the one that rolls, so it takes the last delay. */
const rollDelay = 120 + h.stem.length * 100;
---

<header class="cover">
  <!-- The background figure. Decoration only: it carries no meaning, takes no
       pointer events and is hidden from assistive tech. -->
  <canvas class="cover__field" data-field aria-hidden="true"></canvas>

  <div class="shell">
    <p class="meta cover__eyebrow">{h.eyebrow}</p>

    <h1 class="display cover__h1">
      {h.stem.map((line, n) => (
        <span class="cover__line"><i style={`--d:${120 + n * 100}ms`}>{line}</i></span>
      ))}

      <!-- Every phrase ships in the markup, stacked in one grid cell: the line
           keeps the width of the longest and nothing below it moves as they
           swap, and with no JavaScript the first one simply stays. -->
      <span class="cover__line">
        <i style={`--d:${rollDelay}ms`}>
          <span class="roll" data-roll>
            {h.rotating.map((phrase, n) => (
              <em class:list={['roll__p', { 'is-on': n === 0 }]}>{phrase}</em>
            ))}
          </span>
        </i>
      </span>
    </h1>

    <!-- A dimension line, the way a drawing states an extent. -->
    <div class="dim" aria-label={`${h.from} — ${h.to}`}>
      <span class="meta">{h.from}</span>
      <span class="dim__line"></span>
      <span class="meta">{h.to}</span>
    </div>

    <dl class="sheet">
      {rows.map((row, n) => (
        <div class="sheet__row" data-reveal style={`--reveal-delay:${380 + n * 60}ms`}>
          <dt class="meta">{row.term}</dt>
          <dd>{row.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</header>

<style>
  .cover {
    position: relative;
    padding-block: clamp(7rem, 16vh, 11rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .cover__field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    -webkit-mask-image: radial-gradient(
      78% 68% at var(--fx, 72%) var(--fy, 46%),
      #000 38%,
      transparent 100%
    );
    mask-image: radial-gradient(
      78% 68% at var(--fx, 72%) var(--fy, 46%),
      #000 38%,
      transparent 100%
    );
  }

  /* The claim sits over the figure, never under it. */
  .cover > .shell { position: relative; z-index: 1; }

  .cover__eyebrow {
    display: block;
    opacity: 0;
    animation: fade 700ms var(--ease) 60ms forwards;
  }

  .cover__h1 {
    display: grid;
    margin-top: clamp(1rem, 2.5vw, 2rem);
  }

  /* Each line is a window; the text inside rises out of it on load.

     At a line-height of 0.92 the line box is shorter than the glyphs, so a
     descender falls 0.155em below it — measured, on "Design leadership" — and
     the window that makes the rise work was cutting the tails off every g and
     y. The padding grows the clip region and the negative margin gives the
     space straight back, so the lines sit exactly where they did. */
  .cover__line {
    display: block;
    overflow: hidden;
    padding-block: 0.24em;
    margin-block: -0.24em;
  }

  .cover__line i {
    display: block;
    font-style: normal;
    transform: translateY(135%);
    animation: rise-line 900ms var(--ease) forwards;
    animation-delay: var(--d, 0ms);
  }

  /* The rolling tail. All phrases occupy the same cell, so the block below the
     headline never moves; the line is clipped by .cover__line, which is what
     makes a phrase leave through the top and the next arrive from below. */
  .roll { display: grid; }

  .roll__p {
    grid-area: 1 / 1;
    font-style: normal;
    color: var(--mark);
    transform: translateY(135%);
    opacity: 0;
    transition:
      transform 520ms var(--ease),
      opacity 300ms var(--ease);
  }

  .roll__p.is-on { transform: none; opacity: 1; }
  .roll__p.is-out { transform: translateY(-135%); opacity: 0; }

  /* Justify the stack left so a short phrase does not sit centred under a
     long one. */
  .roll { justify-items: start; }

  @keyframes rise-line { to { transform: none; } }
  @keyframes fade { to { opacity: 1; } }

  .dim {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    padding-block: 0.75rem;
  }

  .dim__line {
    flex: 1;
    height: 1px;
    background: var(--mark);
    transform: scaleX(0);
    transform-origin: left;
    animation: draw 1200ms var(--ease) 620ms forwards;
    position: relative;
  }

  /* Arrow heads, drawn as rotated hairlines rather than shipped as an icon. */
  .dim__line::before,
  .dim__line::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 6px;
    height: 6px;
    border-top: 1px solid var(--mark);
    border-right: 1px solid var(--mark);
  }

  .dim__line::before { left: 0; transform: translateY(-50%) rotate(-135deg); }
  .dim__line::after { right: 0; transform: translateY(-50%) rotate(45deg); }

  @keyframes draw { to { transform: scaleX(1); } }

  .sheet {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    border-top: 1px solid var(--rule);
  }

  .sheet__row {
    display: grid;
    gap: 0.15rem 2rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--rule-2);
  }

  .sheet__row dt { padding-top: 0.3rem; }
  .sheet__row dd { font-size: var(--fs-small); max-width: 62ch; }

  @media (min-width: 700px) {
    .sheet__row { grid-template-columns: var(--rail) minmax(0, 1fr); align-items: baseline; }
    .sheet__row dt { padding-top: 0; }
  }

  /* Reduced motion: everything is simply already in place. */
  @media (prefers-reduced-motion: reduce) {
    .cover__eyebrow { opacity: 1; animation: none; }
    .cover__line i { transform: none; animation: none; }
    .dim__line { transform: none; animation: none; }
    /* The rotation is stopped in script too; this keeps the first phrase
       placed rather than transitioned into place. */
    .roll__p { transition: none; }
  }
</style>
