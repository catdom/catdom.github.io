---
import { hero } from '../data/home';
import type { Lang } from '../data/types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const h = hero[lang];

/* The stem's last line is the one that rolls, so it takes the last delay. */
const rollDelay = 120 + h.stem.length * 100;
---

<header class="cover">
  <!-- The background figure. Decoration only: it carries no meaning, takes no
       pointer events and is hidden from assistive tech. -->
  <canvas class="cover__field" data-field aria-hidden="true"></canvas>

  <div class="shell">
    <!-- Who, then where, with a mark to the left: the row an app puts an
         account in. The initials are decoration — the name is written out
         beside them — so the disc stays out of the accessibility tree. -->
    <div class="cover__who">
      <span class="cover__avatar" aria-hidden="true">{h.initials}</span>
      <span class="cover__lines">
        <span class="meta cover__name">{h.name}</span>
        <span class="meta cover__place">{h.place}</span>
      </span>
    </div>

    <div class="cover__claim">
      <h1 class="display cover__h1">
      {h.stem.map((line, n) => (
        <span class="cover__line"><i style={`--d:${120 + n * 100}ms`}>{line}</i></span>
      ))}

      <!-- Every phrase ships in the markup, stacked in one grid cell: the line
           keeps the width of the longest and nothing below it moves as they
           swap, and with no JavaScript the first one simply stays. -->
      <span class="cover__line">
        <i style={`--d:${rollDelay}ms`}>
          <span class="roll" data-roll>
            {h.rotating.map((phrase, n) => (
              <em class:list={['roll__p', { 'is-on': n === 0 }]}>{phrase}</em>
            ))}
          </span>
        </i>
      </span>
      </h1>

      <!-- The one thing to do on this screen. It is a link, not a heading, so
           it sits beside the claim rather than inside it. -->
      <a class="btn btn--ghost cover__go" href="#capability">
        {h.scroll}
        <svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true" focusable="false">
          <path d="M8 3v10M8 13l-4-4M8 13l4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>


  </div>
</header>

<style>
  /* The hero is sized on load so the brand strip below it lands on the fold;
     the caption and the claim sit centred in whatever height that turns out
     to be. The padding is equal top and bottom so the centring holds in the
     border box too, and its floor — 96px — clears the fixed bar, which
     measures 79px at its tallest. */
  .cover {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(6rem, 12vh, 8rem);
  }

  .cover__field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    -webkit-mask-image: radial-gradient(
      92% 82% at var(--fx, 72%) var(--fy, 46%),
      #000 46%,
      transparent 100%
    );
    mask-image: radial-gradient(
      92% 82% at var(--fx, 72%) var(--fy, 46%),
      #000 46%,
      transparent 100%
    );
  }

  /* The claim sits over the figure, never under it. */
  .cover > .shell { position: relative; z-index: 1; }

  .cover__who {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    opacity: 0;
    animation: fade 700ms var(--ease) 60ms forwards;
  }

  /* 38px is the smallest disc that still holds two letters legibly at the
     caption's weight. White on the mark measures 7.6:1. */
  .cover__avatar {
    flex: none;
    position: relative;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background: var(--mark);
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
  }

  /* The availability light, set on the paper so it reads as an inlay rather
     than a sticker. */
  .cover__avatar::after {
    content: '';
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #1fa971;
    box-shadow: 0 0 0 2.5px var(--paper);
  }

  .cover__lines { display: grid; }
  .cover__name { color: var(--ink); line-height: 1.45; }
  .cover__place { color: var(--ink-3); line-height: 1.45; }

  /* The claim and the invitation share one row, with the link pinned to the
     bottom of it so it lands beside the rotating line whatever it says. */
  .cover__claim {
    display: grid;
    gap: 1rem;
    margin-top: clamp(1rem, 2.5vw, 2rem);
  }

  .cover__h1 { display: grid; }

  .cover__go { justify-self: start; }

  @media (min-width: 900px) {
    .cover__claim {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }

    .cover__go { justify-self: end; margin-bottom: 0.35em; }
  }

  /* Each line is a window; the text inside rises out of it on load.

     At a line-height of 0.92 the line box is shorter than the glyphs, so a
     descender falls 0.155em below it — measured, on "Design leadership" — and
     the window that makes the rise work was cutting the tails off every g and
     y. The padding grows the clip region and the negative margin gives the
     space straight back, so the lines sit exactly where they did. */
  .cover__line {
    display: block;
    overflow: hidden;
    /* Measured, not guessed: at this size the ink starts 0.10em below the top
       of the line box and the descenders fall 0.10em past its bottom. So the
       window opens 0.04em above the type — enough for an accented cap, not
       enough to show the rotating phrase still travelling through the line
       above — and closes 0.17em below it, which clears every g, y and ñ. */
    padding-top: 0.04em;
    padding-bottom: 0.17em;
    margin-top: -0.04em;
    margin-bottom: -0.17em;
  }

  .cover__line i {
    display: block;
    font-style: normal;
    transform: translateY(135%);
    animation: rise-line 900ms var(--ease) forwards;
    animation-delay: var(--d, 0ms);
  }

  /* The rolling tail. All phrases occupy the same cell, so the block below the
     headline never moves; the line is clipped by .cover__line, which is what
     makes a phrase leave through the top and the next arrive from below. */
  .roll { display: grid; }

  .roll__p {
    grid-area: 1 / 1;
    font-style: normal;
    color: var(--mark);
    transform: translateY(135%);
    opacity: 0;
    transition:
      transform 520ms var(--ease),
      opacity 300ms var(--ease);
  }

  .roll__p.is-on { transform: none; opacity: 1; }
  .roll__p.is-out { transform: translateY(-135%); opacity: 0; }

  /* Justify the stack left so a short phrase does not sit centred under a
     long one. */
  .roll { justify-items: start; }

  @keyframes rise-line { to { transform: none; } }
  @keyframes fade { to { opacity: 1; } }

  /* Reduced motion: everything is simply already in place. */
  @media (prefers-reduced-motion: reduce) {
    .cover__who { opacity: 1; animation: none; }
    .cover__line i { transform: none; animation: none; }
    /* The rotation is stopped in script too; this keeps the first phrase
       placed rather than transitioned into place. */
    .roll__p { transition: none; }
  }
</style>
