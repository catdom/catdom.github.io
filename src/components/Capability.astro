---
import { strengthsIntro } from '../data/home';
import { strengths } from '../data/strengths';
import type { Lang } from '../data/types';
import CapabilityIcon from './CapabilityIcon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const i = strengthsIntro[lang];
---

<section class="cap" id="capability">
  <div class="shell">
    <div class="head cap__head">
      <p class="meta meta--mark">{i.label}</p>
      <div>
        <h2 class="h2" data-reveal>{i.heading}</h2>
        <p class="lead cap__note" data-reveal style="--reveal-delay:80ms">{i.body}</p>
      </div>
    </div>

    <div class="parts">
      {strengths.map((s, n) => (
        <article class="part" data-reveal style={`--reveal-delay:${n * 70}ms`}>
          <CapabilityIcon id={s.id} class="part__icon" />
          <p class="meta meta--mark part__id">{s.id}</p>
          <h3 class="h3 part__title">{s.title[lang]}</h3>
          <p class="part__text">{s.body[lang]}</p>
          <p class="meta part__value">{s.value[lang]}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* The section takes the accent full-bleed; the cards keep their own white
     ground, so only the head changes voice. White on the mark measures 7.6:1,
     and the note at 80% white still clears AA at 5.4:1. */
  .cap {
    /* This section carries its own ground, so it lands flush with the top of
       the screen: the blue is the clearance the bar needs, and the heading is
       already a section's padding below it. */
    scroll-margin-top: 0;
    padding-block: var(--section-y);
    background: var(--mark);
    color: #ffffff;
  }

  /* Only the head changes voice: the cards keep their own ground and their
     own ink, so the metadata inside them must not be turned white. */
  .cap__head .meta { color: rgba(255, 255, 255, 0.75); }
  .cap__head .h2 { color: #ffffff; }

  /* The rule the cards hang from is the same hairline that draws them, not the
     heavier ink rule the other section heads use: it is the top edge of the
     first row of boxes, so it has to match their other three sides. */
  .cap__head {
    padding-bottom: clamp(1.5rem, 3.5vw, 2.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.28);
  }

  .cap__note { max-width: 54ch; color: rgba(255, 255, 255, 0.8); }

  /* Four cards, tiled on the rig: one column, then two of the eight behind
     them, then three of the twelve. The hairlines are inset shadows rather
     than gaps or borders, so a card edge lands exactly on a drawn line and
     two neighbours never double the rule between them. */
  .parts { display: grid; gap: 0; }

  /* The card is a panel, not an outline: white ground on the paper, its edges
     on the rig lines and its content inset from them. */
  .part {
    display: grid;
    /* The text row takes the slack, so the outcome sits on the floor of every
       card in a row however long the paragraph above it runs. */
    grid-template-rows: auto auto auto 1fr auto;
    /* No row gap: the card's rhythm is set by each element's own margin, so
       the 24px between the name and everything above it is exactly 24px. */
    gap: 0;
    position: relative;
    background: var(--panel);
    --card-pad: clamp(1.35rem, 2.4vw, 1.75rem);
    padding: var(--card-pad);
    /* Every card draws its own right and bottom edge; only the one that opens
       a row draws a left edge, so the strip is closed on both sides and no two
       neighbours ever stack two rules into one 2px line. */
    --left-rule: inset 1px 0 0 var(--rule);
    box-shadow: var(--left-rule), inset -1px -1px 0 var(--rule);
    color: var(--ink);
  }

  @media (min-width: 700px) {
    .parts { grid-template-columns: repeat(8, minmax(0, 1fr)); }
    .part { grid-column: span 4; }
    .part:nth-child(even) { --left-rule: 0 0 0 0 transparent; }
  }

  @media (min-width: 1100px) {
    .parts { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .part { grid-column: span 6; }
    .part:nth-child(even) { --left-rule: 0 0 0 0 transparent; }
  }

  /* The mark opens the card, on its own left edge: an icon, not a picture,
     so it takes the accent solid. */
  /* The card's vertical rhythm is set in ink, not in boxes: these margins are
     chosen so the visible gaps match the design — 10px under the mark, 38px
     over the name, 17px under it — once each line's own leading is taken off.
     Changing a font size or a line-height changes what these should be. */
  /* The gap under the mark is set in CapabilityIcon, which owns that element. */

  .part__text {
    margin-top: 10px;
    color: var(--ink-2);
    font-size: var(--fs-body);
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* The measured outcome closes the card, on its own rule, the way a drawing
     calls out a dimension under the part it belongs to. */
  .part__value {
    margin-top: auto;
    padding-top: 24px;
    color: var(--ink-3);
  }

  .part__value::before {
    content: '';
    display: block;
    width: 1.75rem;
    height: 1px;
    margin-bottom: 12px;
    background: var(--rule);
  }

  /* Hover is the only state a card has, and it stays inside the drawing: the
     rule under the value runs out and takes the mark's colour. */
  .part__title {
    margin-top: 28px;
    font-weight: 700;
  }

</style>
