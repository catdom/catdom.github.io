---
/**
 * The four capability marks, as supplied: one silhouette each, solid in the
 * accent. Inline rather than four files, so they take the colour from the
 * cascade and cost no request. Decorative — the title beside them says the
 * same thing — so they stay out of the accessibility tree.
 */
interface Props {
  /** PT-01 … PT-04. */
  id: string;
  class?: string;
}

const { id, class: extra } = Astro.props as Props;

const PATHS: Record<string, string> = {
  /* A burst: every arm pointing at one centre. */
  'PT-01':
    'M 152 70.059 L 201.539 20.519 L 235.48 54.461 L 185.941 104 L 256 104 L 256 152 L 185.941 152 L 235.48 201.539 L 201.539 235.48 L 152 185.941 L 152 256 L 104 256 L 104 185.941 L 54.46 235.48 L 20.52 201.539 L 70.059 152 L 0 152 L 0 104 L 70.059 104 L 20.519 54.46 L 54.461 20.52 L 104 70.059 L 104 0 L 152 0 Z',
  /* Four quadrants: the figure is the seam between them. */
  'PT-02':
    'M 100 136 C 111.046 136 120 144.954 120 156 L 120 256 L 100 256 C 44.772 256 0 211.228 0 156 L 0 136 Z M 256 256 L 136 256 L 136 156 C 136 144.954 144.954 136 156 136 L 256 136 Z M 120 100 C 120 111.046 111.046 120 100 120 L 0 120 L 0 100 C 0 44.772 44.772 0 100 0 L 120 0 Z M 156 0 C 211.228 0 256 44.772 256 100 L 256 120 L 156 120 C 144.954 120 136 111.046 136 100 L 136 0 Z',
  /* Two squares locked into one another: a system is parts that fit. */
  'PT-03':
    'M 256 192 C 256 227.346 227.346 256 192 256 L 0 256 L 0 64 C 0 28.654 28.654 0 64 0 L 256 0 Z M 128 192 L 192 192 L 192 128 L 128 128 L 128 64 L 64 64 L 64 128 L 128 128 Z',
  /* Four petals: one centre opening out. */
  'PT-04':
    'M 78 0 C 105.614 0 128 22.386 128 50 C 128 22.386 150.386 0 178 0 L 256 0 L 256 78 C 256 105.614 233.614 128 206 128 C 233.614 128 256 150.386 256 178 L 256 256 L 178 256 C 150.386 256 128 233.614 128 206 C 128 233.614 105.614 256 78 256 L 0 256 L 0 178 C 0 150.386 22.386 128 50 128 C 22.386 128 0 105.614 0 78 L 0 0 Z',
};

const d = PATHS[id];
---

{
  d && (
    <svg
      class:list={['cap-icon', extra]}
      viewBox="0 0 256 256"
      width="32"
      height="32"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d={d} />
    </svg>
  )
}

<style>
  .cap-icon {
    display: block;
    color: var(--mark);
    /* The gap under the mark lives here rather than on the card: the parent's
       scoped styles do not reach this element, since it renders inside a
       conditional. */
    margin-bottom: 5px;
  }
</style>
