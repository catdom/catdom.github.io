---
import { site, ui, availability } from '../data/site';
import Icon from './Icon.astro';
import type { Lang } from '../data/types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const a = availability[lang];
const year = new Date().getFullYear();
---

<footer class="foot on-dark" data-tone="dark">
  <div class="shell">
    <div class="foot__card">
      <p class="foot__avail" data-reveal>
        <span class="chip">{a.badge}</span>
        <span>{a.note}</span>
      </p>

      <a class="foot__email" href={`mailto:${site.email}`} data-reveal style="--reveal-delay:80ms">
        {site.email}
      </a>

      <div class="foot__bar">
        <p class="foot__legal">© {year} {site.name} · {ui[lang].rights}</p>

        <ul class="foot__links">
          <li>
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
              LinkedIn
              <Icon name="arrow-up-right" size={14} />
            </a>
          </li>
          <li><a href={`mailto:${site.email}`}>Email</a></li>
        </ul>

        <a class="foot__top" href="#top">
          {ui[lang].backToTop}
          <Icon name="arrow-up" size={14} />
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .foot { padding-block: clamp(1rem, 3vw, 2.5rem) clamp(1rem, 3vw, 2.5rem); background: var(--paper); }

  .foot__card {
    background: var(--dark);
    color: var(--on-dark);
    border-radius: var(--r-band);
    padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.5rem, 3.5vw, 3.5rem);
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .foot__avail {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--fs-small);
    color: var(--on-dark-muted);
  }

  /* The email is the page's closing statement, so it carries display weight. */
  .foot__email {
    font-size: clamp(1.6rem, 5.2vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    word-break: break-word;
    justify-self: start;
    border-bottom: 2px solid transparent;
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .foot__email:hover { border-color: var(--lavender); color: var(--lavender); }

  .foot__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--dark-line);
    font-size: var(--fs-small);
    color: var(--on-dark-faint);
  }

  .foot__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.5rem;
  }

  .foot__links a,
  .foot__top {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--on-dark-muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .foot__links a:hover,
  .foot__top:hover { color: var(--on-dark); }
</style>
