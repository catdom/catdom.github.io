---
import { site, ui, availability } from '../data/site';
import { langPrefix, type Lang } from '../data/types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const u = ui[lang];
const year = new Date().getFullYear();
---

<footer class="foot" id="contact">
  <div class="shell">
    <p class="meta">{u.contactLabel}</p>

    <!-- LinkedIn is the only contact route on the site: there is no form and
         no mailto anywhere. -->
    <a class="foot__cta" href={site.linkedin} rel="me noopener" target="_blank" data-reveal>
      <span>{u.contactHeading}</span>
      <svg viewBox="0 0 24 24" width="0.7em" height="0.7em" aria-hidden="true" focusable="false">
        <path d="M6 18L18 6M18 6H8.5M18 6v9.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="visually-hidden">{u.contactOn}</span>
    </a>

    <div class="foot__meta">
      <span class="meta">linkedin.com/in/jordicatalan</span>
      <span class="meta">{site.location}, {lang === 'en' ? 'Spain' : 'España'}</span>
      <span class="meta">{u.contactNote}</span>
    </div>

    <div class="foot__base">
      <span class="meta">© {year} {site.name} · {u.rights}</span>
      <span class="meta">{availability[lang].note}</span>
      <a class="meta foot__top" href={`${langPrefix(lang)}/`}>{u.backToTop}</a>
    </div>
  </div>
</footer>

<style>
  .foot {
    padding-block: clamp(4rem, 12vw, 8rem) clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--ink);
  }

  .foot__cta {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    margin-top: clamp(1.25rem, 3vw, 2rem);
    font-size: clamp(2rem, 6.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 500;
    border-bottom: 2px solid transparent;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .foot__cta:hover,
  .foot__cta:focus-visible {
    color: var(--mark);
    border-bottom-color: var(--mark);
  }

  /* The two metadata rows sit on the rig like everything else: three columns
     of the twelve for each fact, so the footer keeps the page's column edges
     right down to the last line. Below the rig's own breakpoint they simply
     wrap. */
  .foot__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    margin-top: clamp(2rem, 6vw, 3.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule-2);
  }

  .foot__base {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    margin-top: clamp(2.5rem, 7vw, 4rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule-2);
  }

  @media (min-width: 700px) {
    .foot__meta,
    .foot__base {
      display: grid;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      gap: 0.5rem 0;
    }

    .foot__meta > *,
    .foot__base > * { grid-column: span 3; padding-right: var(--col-pad); }
    .foot__meta > :first-child,
    .foot__base > :first-child { grid-column: span 2; }
  }

  @media (min-width: 1100px) {
    .foot__meta,
    .foot__base { grid-template-columns: repeat(12, minmax(0, 1fr)); }

    .foot__meta > *,
    .foot__base > * { grid-column: span 4; }
  }

  .foot__top { margin-left: auto; justify-self: end; padding-right: 0; }
  .foot__top:hover { color: var(--ink); }

  /* Touch: 'back to top' is a 18px-tall line of metadata. Pad the hit area
     and take the space back so the row keeps its rhythm. */
  @media (pointer: coarse) {
    .foot__cta { padding-block: 0.35rem; }

    .foot__top {
      padding-block: 0.8rem;
      margin-block: -0.8rem;
    }
  }
</style>
