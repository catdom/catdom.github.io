---
import { site, ui, availability } from '../data/site';
import { langPrefix, type Lang } from '../data/types';
import Button from './ui/Button.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const u = ui[lang];
const year = new Date().getFullYear();
---

<footer class="foot" id="contact">
  <div class="shell">
    <p class="meta meta--mark foot__label">{u.contactLabel}</p>

    <!-- LinkedIn is the only contact route on the site: there is no form and
         no mailto anywhere. -->
    <a class="foot__cta" href={site.linkedin} rel="me noopener" target="_blank" data-reveal>
      <span>{u.contactHeading}</span>
      <svg viewBox="0 0 24 24" width="0.7em" height="0.7em" aria-hidden="true" focusable="false">
        <path d="M6 18L18 6M18 6H8.5M18 6v9.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="visually-hidden">{u.contactOn}</span>
    </a>

    <div class="foot__meta">
      <Button as="a" variant="ghost" href={site.linkedin} rel="me noopener" target="_blank">
        {u.linkedin}
        <svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true" focusable="false">
          <path d="M4 12L12 4M12 4H5.5M12 4v6.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </Button>
      <span class="meta foot__note">{u.contactNote}</span>
    </div>

    <div class="foot__base">
      <span class="meta foot__legal">© {year} {site.name}, {availability[lang].note}</span>
      <a class="meta foot__top" href={`${langPrefix(lang)}/`}>{u.backToTop}</a>
    </div>
  </div>
</footer>

<style>
  /* The page closes on ink. Same trick as the figures above: the ground
     redefines the tokens, so the ghost button, the hairlines and every line
     of metadata come over without being restyled. The mark is the lifted one
     — the site's own blue reads 2.5:1 here. */
  .foot {
    padding-block: var(--section-y) clamp(2rem, 5vw, 3rem);
    background: var(--ground-dark);
    color: var(--on-dark);

    --paper: var(--ground-dark);
    --ink: var(--on-dark);
    --ink-2: var(--on-dark-2);
    --ink-3: var(--on-dark-2);
    --rule: var(--rule-dark);
    --rule-2: var(--rule-dark);
    --mark: var(--mark-on-dark);
  }

  .foot__label { display: block; margin-top: 0; }

  .foot__cta {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    margin-top: clamp(1.25rem, 3vw, 2rem);
    font-size: clamp(2rem, 6.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 500;
    border-bottom: 2px solid transparent;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .foot__cta:hover,
  .foot__cta:focus-visible {
    color: var(--mark);
    border-bottom-color: var(--mark);
  }

  /* The two metadata rows sit on the rig like everything else: three columns
     of the twelve for each fact, so the footer keeps the page's column edges
     right down to the last line. Below the rig's own breakpoint they simply
     wrap. */
  .foot__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    margin-top: clamp(2rem, 6vw, 3.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule-2);
  }

  .foot__base {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    margin-top: clamp(2.5rem, 7vw, 4rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule-2);
  }

  /* The closing line sits in the middle of the page and 'back to top' closes
     it on the right; on a phone they simply stack. */
  @media (min-width: 700px) {
    .foot__base {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: baseline;
      gap: 0 1rem;
    }

    .foot__legal { grid-column: 2; text-align: center; }
    .foot__top { grid-column: 3; justify-self: end; }

    .foot__meta { align-items: center; gap: 1rem 2rem; }
  }

  .foot__top { margin-left: auto; }
  .foot__top:hover { color: var(--ink); }

  /* Touch: 'back to top' is a 18px-tall line of metadata. Pad the hit area
     and take the space back so the row keeps its rhythm. */
  @media (pointer: coarse) {
    .foot__cta { padding-block: 0.35rem; }

    .foot__top {
      padding-block: 0.8rem;
      margin-block: -0.8rem;
    }
  }
</style>
