---
import { site, ui, availability } from '../data/site';
import Icon from './Icon.astro';
import type { Lang } from '../data/types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const a = availability[lang];
const year = new Date().getFullYear();
---

<footer class="foot on-dark" data-tone="dark">
  <div class="shell">
    <div class="foot__card">
      <p class="foot__avail" data-reveal>
        <span class="chip">{a.badge}</span>
        <span>{a.note}</span>
      </p>

      {
        site.formspreeId ? (
          <div class="foot__contact" data-reveal style="--reveal-delay:80ms">
            <h2 class="foot__formTitle">{ui[lang].formTitle}</h2>

            <form
              class="cform"
              data-cform
              action={`https://formspree.io/f/${site.formspreeId}`}
              method="POST"
              novalidate
              data-msg-required={ui[lang].formRequired}
              data-msg-bad-email={ui[lang].formBadEmail}
              data-msg-sending={ui[lang].formSending}
              data-msg-send={ui[lang].formSend}
              data-msg-sent={ui[lang].formSent}
              data-msg-error={ui[lang].formError}
              data-email={site.email}
            >
              <div class="field">
                <label for="cf-name">{ui[lang].formName}</label>
                <div class="field__control">
                  <input id="cf-name" name="name" type="text" required autocomplete="name" />
                  <p class="field__err" data-err-for="cf-name" hidden></p>
                </div>
              </div>

              <div class="field">
                <label for="cf-email">{ui[lang].formEmail}</label>
                <div class="field__control">
                  <input id="cf-email" name="email" type="email" required autocomplete="email" />
                  <p class="field__err" data-err-for="cf-email" hidden></p>
                </div>
              </div>

              <div class="field">
                <label for="cf-message">{ui[lang].formMessage}</label>
                <div class="field__control">
                  <textarea id="cf-message" name="message" rows="1" required data-autogrow></textarea>
                  <p class="field__err" data-err-for="cf-message" hidden></p>
                </div>
              </div>

              {/* Gives the notification email a useful subject line instead
                  of Formspree's generic one. */}
              <input type="hidden" name="_subject" value={ui[lang].formSubject} />

              {/* Formspree drops anything that fills this in. Hidden from
                  everyone but a bot walking the DOM. */}
              <input
                class="honeypot"
                type="text"
                name="_gotcha"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
              />

              <div class="cform__foot">
                <button class="cform__send" type="submit" data-send>
                  {ui[lang].formSend}
                </button>
                <p class="cform__status" data-status role="status" aria-live="polite"></p>
              </div>
            </form>

            <p class="foot__orEmail">
              {ui[lang].formOrEmail}{' '}
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          </div>
        ) : (
          <a class="foot__email" href={`mailto:${site.email}`} data-reveal style="--reveal-delay:80ms">
            {site.email}
          </a>
        )
      }

      <div class="foot__bar">
        <p class="foot__legal">© {year} {site.name} · {ui[lang].rights}</p>

        <ul class="foot__links">
          <li>
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
              LinkedIn
              <Icon name="arrow-up-right" size={14} />
            </a>
          </li>
          <li><a href={`mailto:${site.email}`}>Email</a></li>
        </ul>

        <a class="foot__top" href="#top">
          {ui[lang].backToTop}
          <Icon name="arrow-up" size={14} />
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .foot { padding-block: clamp(1rem, 3vw, 2.5rem) clamp(1rem, 3vw, 2.5rem); background: var(--paper); }

  .foot__card {
    background: var(--dark);
    color: var(--on-dark);
    border-radius: var(--r-band);
    padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.5rem, 3.5vw, 3.5rem);
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .foot__avail {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--fs-small);
    color: var(--on-dark-muted);
  }

  /* The email is the page's closing statement, so it carries display weight. */
  .foot__email {
    font-size: clamp(1.6rem, 5.2vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    word-break: break-word;
    justify-self: start;
    border-bottom: 2px solid transparent;
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .foot__email:hover { border-color: var(--lavender); color: var(--lavender); }

  /* --- Contact form --------------------------------------------------------
     Laid out as a list of labelled rows rather than boxed inputs: a small
     letterspaced label in the left rail, the value on a single underline to
     the right, hairlines between. */

  .foot__contact { display: grid; gap: clamp(1.75rem, 3vw, 2.5rem); }

  .foot__formTitle {
    font-size: clamp(1.6rem, 4.4vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 500;
    margin: 0;
  }

  .cform { max-width: 52rem; }

  .field {
    display: grid;
    align-items: start;
    gap: 0.35rem clamp(1rem, 3vw, 2.5rem);
    padding-block: clamp(0.9rem, 1.8vw, 1.35rem);
    border-top: 1px solid var(--dark-line);
  }

  .field label {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-faint);
    /* Optically level with the first line of the value beside it. */
    padding-top: 0.45rem;
  }

  .field__control { display: grid; gap: 0.5rem; min-width: 0; }

  .field input,
  .field textarea {
    font: inherit;
    color: var(--on-dark);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--dark-line);
    border-radius: 0;
    padding: 0.15rem 0 0.5rem;
    width: 100%;
    /* An underline field is naturally short; this keeps the tap target at the
       44px floor without boxing it back in. An input centres its own text in
       the extra room. */
    min-height: 2.75rem;
    /* Below this iOS zooms the page when the field takes focus. */
    font-size: max(1.05rem, 16px);
    transition: border-color var(--dur-fast) var(--ease);
  }

  /* Starts as a single underline like the rows above it and grows with the
     text, so all three read as the same control at rest. */
  .field textarea {
    resize: none;
    overflow: hidden;
    line-height: 1.5;
  }

  .field input::placeholder,
  .field textarea::placeholder { color: var(--on-dark-faint); }

  .field input:hover,
  .field textarea:hover { border-bottom-color: var(--on-dark-faint); }

  /* The underline is the focus indicator, so it has to carry real weight —
     hence a box-shadow rather than a thicker border, which would shift the
     text by a pixel as it lands. */
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--lavender);
    box-shadow: 0 1px 0 0 var(--lavender);
  }

  .field[data-invalid] input,
  .field[data-invalid] textarea { border-bottom-color: #e88b8b; }

  .field__err {
    font-size: var(--fs-small);
    color: #e88b8b;
    margin: 0;
  }

  .honeypot { display: none; }

  .cform__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    padding-top: clamp(1.25rem, 2.4vw, 1.75rem);
    border-top: 1px solid var(--dark-line);
  }

  /* Bordered, letterspaced and quiet, like the reference's COPIAR. */
  .cform__send {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark);
    background: none;
    border: 1px solid var(--on-dark-faint);
    border-radius: var(--r-pill);
    padding: 0.85rem 1.6rem;
    transition:
      background var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      opacity var(--dur-fast) var(--ease);
  }

  .cform__send:hover {
    background: var(--lavender);
    border-color: var(--lavender);
    color: var(--ink);
  }

  .cform__send[disabled] { opacity: 0.45; cursor: default; }

  .cform__status {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--on-dark-muted);
    /* Holds its line so the button never jumps when a message appears. */
    min-height: 1.2em;
  }

  .cform__status a { color: var(--lavender); text-decoration: underline; }

  /* Sent: the form is replaced by its own confirmation. */
  .cform[data-sent] { display: none; }

  .foot__orEmail {
    font-size: var(--fs-small);
    color: var(--on-dark-faint);
    margin: 0;
  }

  .foot__orEmail a {
    color: var(--on-dark-muted);
    border-bottom: 1px solid var(--dark-line);
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .foot__orEmail a:hover { color: var(--on-dark); border-color: var(--on-dark); }

  @media (min-width: 620px) {
    .field { grid-template-columns: 8.5rem minmax(0, 1fr); }
  }

  .foot__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--dark-line);
    font-size: var(--fs-small);
    color: var(--on-dark-faint);
  }

  .foot__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.5rem;
  }

  .foot__links a,
  .foot__top {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--on-dark-muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .foot__links a:hover,
  .foot__top:hover { color: var(--on-dark); }
</style>
