---
/**
 * A bento cell.
 *
 * `.tilt-root` owns the 3D transform; `.card` owns the surface. Keeping them
 * as two elements means the per-frame transform writes never invalidate the
 * card's own colour/shadow transitions, and the specular gradient can sit on
 * ::after without being counter-rotated.
 *
 * `col`/`row` are spans on the 12-column desktop grid. layout.css collapses
 * them sensibly at 6-col and 2-col breakpoints — you never set a mobile span.
 */
interface Props {
  col?: 3 | 4 | 6 | 8 | 12;
  row?: 1 | 2 | 3;
  href?: string;
  accent?: boolean;
  quiet?: boolean;
  tilt?: boolean;
  class?: string;
  label?: string;
  labelIndex?: string;
}

const {
  col = 6,
  row = 1,
  href,
  accent = false,
  quiet = false,
  tilt = true,
  class: className,
  label,
  labelIndex,
} = Astro.props;
---

<div class="tilt-root" data-col={String(col)} data-row={String(row)}>
  <div
    class:list={[
      'card',
      accent && 'card--accent',
      quiet && 'card--quiet',
      href && 'card--link',
      className,
    ]}
    data-tilt={tilt ? '' : undefined}
    data-lottie-zone
  >
    {
      label && (
        <p
          class:list={['label', labelIndex && 'label--index']}
          data-index={labelIndex}
        >
          {label}
        </p>
      )
    }
    <slot />
    {
      href && (
        /* Stretched link: the whole card is the hit area, but the accessible
           name and focus ring stay on a real anchor. */
        <a href={href} class="card__hit">
          <span class="visually-hidden"><slot name="link-label">Open</slot></span>
        </a>
      )
    }
  </div>
</div>

<style>
  .card__hit {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }
  .card__hit:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }
</style>
