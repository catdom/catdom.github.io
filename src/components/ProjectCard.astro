---
import type { CollectionEntry } from 'astro:content';
import BentoCard from './BentoCard.astro';
import Lottie from './Lottie.astro';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { data } = project;
const idx = String(index + 1).padStart(2, '0');
---

<BentoCard
  col={data.layout.col}
  row={data.layout.row}
  accent={data.layout.accent}
  href={`/work/${project.id}`}
>
  <div class="head">
    <p class="label label--index" data-index={idx}>{data.org} · {data.year}</p>
    {
      /* The Lottie arrow is drawn in the accent colour, so on an accent-filled
         card it would be invisible. There, fall back to the inline icon,
         which inherits currentColor. */
      data.layout.accent ? (
        <Icon name="arrow-ne" size={22} />
      ) : (
        <Lottie name="arrow" fallback="arrow-ne" size={22} trigger="hover" />
      )
    }
  </div>

  <h3 class="title">{data.title}</h3>
  <p class="summary">{data.summary}</p>

  <div class="push-end foot">
    {data.outcome && <p class="outcome">{data.outcome}</p>}
    <ul class="tags" role="list">
      {data.tags.slice(0, 3).map((t) => <li class="tag">{t}</li>)}
    </ul>
  </div>

  <Fragment slot="link-label">Read the {data.title} case study</Fragment>
</BentoCard>

<style>
  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .title {
    margin-block-start: var(--space-6);
    font-size: var(--step-2);
    font-variation-settings: 'wght' 520, 'wdth' 96;
  }
  .summary {
    margin-block-start: var(--space-3);
    max-width: 44ch;
    color: var(--text-2);
    font-size: var(--step--1);
  }
  :global(.card--accent) .summary { color: inherit; opacity: 0.82; }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block-start: var(--space-6);
  }
  .outcome {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  :global(.card--accent) .outcome,
  :global(.card--accent) .tag { color: inherit; }
  :global(.card--accent) .tag { border-color: color-mix(in oklab, var(--accent-ink) 30%, transparent); }
</style>
