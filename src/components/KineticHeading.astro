---
/**
 * Splits a heading into per-word spans at BUILD time, not in the browser.
 *
 * This matters: splitting client-side would mean the heading reflows after
 * hydration (layout shift), and would leave a JS-disabled visitor with the
 * unsplit string only if the script happened to run. Here the markup is
 * final in the HTML response and the JS only ever writes CSS variables.
 *
 * The inner <span> exists so the entrance transform (translate) is separate
 * from the variable-font axis animation on the word itself — animating both
 * on one element makes them fight.
 */
interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'h3' | 'p';
  class?: string;
  /** Opt out of the staggered rise (used for above-the-fold headings). */
  animateEntrance?: boolean;
  id?: string;
}

const {
  text,
  as: Tag = 'h2',
  class: className,
  animateEntrance = true,
  id,
} = Astro.props as Props;

const words = text.split(/\s+/).filter(Boolean);
---

<Tag
  id={id}
  class:list={['kinetic', className]}
  data-enter={animateEntrance ? 'pending' : 'done'}
>
  {
    words.map((word, i) => (
      <>
        <span class="kinetic__word"><span>{word}</span></span>
        {i < words.length - 1 && ' '}
      </>
    ))
  }
</Tag>
