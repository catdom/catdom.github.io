---
/** Stroke-based icons on a 24px grid. No emoji, no icon font. */
interface Props {
  name:
    | 'strategy'
    | 'operations'
    | 'system'
    | 'leadership'
    | 'plus'
    | 'arrow-up-right'
    | 'arrow-down'
    | 'arrow-up'
    | 'arrow-left';
  size?: number;
  class?: string;
}
const { name, size = 24, class: className } = Astro.props;

const paths: Record<Props['name'], string> = {
  // A route plotted between points — direction chosen from evidence.
  strategy: '<circle cx="5" cy="19" r="2"/><circle cx="19" cy="5" r="2"/><path d="M5 17V9a4 4 0 0 1 4-4h3"/><path d="M12 19h3a4 4 0 0 0 4-4V9"/>',
  // Interlocking cycle — the rituals and workflows that keep delivery moving.
  operations: '<path d="M4 12a8 8 0 0 1 13.7-5.6L20 8"/><path d="M20 12a8 8 0 0 1-13.7 5.6L4 16"/><path d="M20 4v4h-4"/><path d="M4 20v-4h4"/>',
  // Repeating modules on a shared grid.
  system: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><path d="M14 17.5h7M17.5 14v7"/>',
  // People, one stepping forward.
  leadership: '<circle cx="9" cy="7" r="3"/><path d="M3 20v-1a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v1"/><path d="M16.5 5.5a3 3 0 0 1 0 5"/><path d="M18 14.2A5 5 0 0 1 21 19v1"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  'arrow-up-right': '<path d="M7 17 17 7"/><path d="M8 7h9v9"/>',
  'arrow-down': '<path d="M12 5v14"/><path d="M6 13l6 6 6-6"/>',
  'arrow-up': '<path d="M12 19V5"/><path d="M6 11l6-6 6 6"/>',
  'arrow-left': '<path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/>',
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
