---
import { availability, ui } from '../data/site';
import { hero } from '../data/home';
import Icon from './Icon.astro';
import type { Lang } from '../data/types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const h = hero[lang];
const a = availability[lang];
---

<section class="hero" id="top" data-tone="light">
  <!-- Soft ground shapes, barely there — depth without ornament. -->
  <svg class="hero__ground" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <path d="M300 900C300 640 420 470 640 400 500 520 470 700 500 900Z" />
    <path d="M760 900C740 610 880 420 1130 340 950 500 900 690 940 900Z" />
    <path d="M-40 900C-20 720 60 600 200 545 90 660 70 780 95 900Z" />
  </svg>

  <div class="shell hero__inner">
    <p class="chip hero__eyebrow" data-reveal>{h.eyebrow}</p>

    <h1 class="display hero__title">
      {h.stem.map((line, i) => (
        <span class="hero__line" data-reveal style={`--reveal-delay:${80 + i * 90}ms`}>{line}</span>
      ))}

      {/* The rotating tail. Every phrase is in the markup: the whole headline
          is readable to search engines and to anyone without JavaScript, who
          simply sees the first one. */}
      <span
        class="hero__line hero__rotator"
        data-rotator
        data-reveal
        style={`--reveal-delay:${80 + h.stem.length * 90}ms`}
      >
        {h.rotating.map((phrase, i) => (
          <span class="hero__phrase" data-phrase aria-hidden={i > 0 ? 'true' : undefined}>
            {phrase}
          </span>
        ))}
      </span>
    </h1>

    <p class="lead hero__body" data-reveal style="--reveal-delay:280ms">{h.body}</p>
  </div>

  <div class="shell hero__foot">
    <p class="hero__avail" data-reveal style="--reveal-delay:380ms">
      <span class="chip">{a.badge}</span>
      <span class="hero__availNote">{a.note}</span>
    </p>

    <a class="pill pill--ghost hero__scroll" href="#roles" data-reveal style="--reveal-delay:380ms">
      {ui[lang].scroll}
      <Icon name="arrow-down" size={15} />
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    background: var(--lavender);
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: center;
    padding-block: 8rem 1.75rem;
    overflow: hidden;
  }

  .hero__ground {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: #fff;
    opacity: 0.4;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: clamp(1.25rem, 2.4vw, 2rem);
  }

  .hero__eyebrow { background: rgb(255 255 255 / 0.55); }

  .hero__title {
    display: grid;
    justify-items: center;
    max-width: min(100%, 22ch);
    /* Its own scale rather than --fs-display: the rotating tail is the longest
       line on the page and must not break, so on narrow screens the headline
       has to be allowed smaller than the shared display minimum. */
    font-size: clamp(1.6rem, 8.1vw, 6.75rem);
  }

  .hero__line { display: block; }

  /* --- Rotating tail -------------------------------------------------------
     Each phrase is stacked in the same grid cell, so the line keeps the width
     of the longest one and nothing below it moves as they swap. The box is
     clipped, and phrases travel through it: out through the top, in from
     the bottom. */

  .hero__rotator {
    display: grid;
    grid-template-areas: 'phrase';
    justify-items: center;
    overflow: hidden;
    /* Descenders and the clip would fight without a little room. */
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .hero__phrase {
    grid-area: phrase;
    /* A phrase that wraps would make the box two lines tall for all of them. */
    white-space: nowrap;
    /* Held below the line until it is this phrase's turn. */
    transform: translateY(100%);
    opacity: 0;
    transition:
      transform var(--roll, 260ms) cubic-bezier(0.22, 1, 0.36, 1),
      opacity var(--roll, 260ms) cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero__phrase[data-in] { transform: translateY(0); opacity: 1; }
  .hero__phrase[data-out] { transform: translateY(-100%); opacity: 0; }

  /* Without JavaScript the first phrase simply sits there. */
  .hero__rotator:not([data-ready]) .hero__phrase:first-child {
    transform: none;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__phrase { transition-duration: 1ms; }
  }

  .hero__body { max-width: 46ch; color: #4e4a56; }

  .hero__foot {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .hero__avail {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }

  .hero__availNote { border-left: 1px solid var(--lavender-line); padding-left: 0.75rem; }

  .hero__scroll { background: rgb(255 255 255 / 0.55); }

  @media (max-width: 600px) {
    .hero__foot { justify-content: flex-start; }
    .hero__scroll { display: none; }
  }
</style>
