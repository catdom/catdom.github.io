---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BentoCard from '../../components/BentoCard.astro';
import KineticHeading from '../../components/KineticHeading.astro';
import Icon from '../../components/Icon.astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', ({ data }) => data.published);
  const sorted = [...projects].sort((a, b) => a.data.order - b.data.order);

  return sorted.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      // Precomputed so the template does no lookups.
      prev: sorted[(i - 1 + sorted.length) % sorted.length]!,
      next: sorted[(i + 1) % sorted.length]!,
    },
  }));
}) satisfies GetStaticPaths;

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const links = [
  data.links.live && { label: 'Live site', href: data.links.live },
  data.links.repo && { label: 'Source', href: data.links.repo },
  data.links.writeup && { label: 'Write-up', href: data.links.writeup },
].filter(Boolean) as Array<{ label: string; href: string }>;
---

<Layout title={data.title} description={data.summary} variant="inner">
  <article>
    <!-- ══ HEADER ═══════════════════════════════════════════════════════ -->
    <section class="section case-head">
      <div class="container">
        <a class="back nav__link" href="/#work">
          <Icon name="arrow-right" size={15} class="back__icon" />
          All work
        </a>

        <p class="label case-head__meta">
          {data.org} · {data.year} · {data.role}
        </p>

        <KineticHeading text={data.title} as="h1" animateEntrance={false} />

        <p class="case-head__summary measure">{data.summary}</p>

        <div class="cluster case-head__actions">
          {
            links.map((l) => (
              <a class="btn" href={l.href} rel="noopener" target="_blank">
                {l.label}
                <Icon name="arrow-ne" size={15} />
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══ FACTS + BODY ═════════════════════════════════════════════════ -->
    <section class="section">
      <div class="container">
        <div class="bento">
          <BentoCard col={4} row={1} quiet label="Role">
            <p class="fact">{data.role}</p>
          </BentoCard>

          <BentoCard col={4} row={1} quiet label="Year">
            <p class="fact">{data.year}</p>
          </BentoCard>

          <BentoCard col={4} row={1} quiet label={data.outcome ? 'Outcome' : 'Stack'}>
            <p class="fact">{data.outcome ?? data.tags.join(' · ')}</p>
          </BentoCard>
        </div>

        <div class="prose case-body">
          <Content />
        </div>

        <ul class="tags case-tags" role="list">
          {data.tags.map((t) => <li class="tag">{t}</li>)}
        </ul>
      </div>
    </section>

    <!-- ══ NEXT ═════════════════════════════════════════════════════════ -->
    <section class="section">
      <div class="container">
        <div class="bento">
          <BentoCard col={12} row={1} href={`/work/${next.id}`} label="Next project">
            <div class="next">
              <h2 class="next__title">{next.data.title}</h2>
              <Icon name="arrow-right" size={22} class="next__arrow" />
            </div>
            <Fragment slot="link-label">Next: {next.data.title}</Fragment>
          </BentoCard>
        </div>
      </div>
    </section>
  </article>
</Layout>

<style>
  .case-head { padding-block-start: clamp(2.5rem, 6vh, 5rem); }
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step--1);
  }
  .back__icon { rotate: 180deg; }
  .case-head__meta { margin-block-start: var(--space-7); }
  .case-head h1 { margin-block-start: var(--space-4); font-size: var(--step-5); }
  .case-head__summary {
    margin-block-start: var(--space-5);
    font-size: var(--step-1);
    color: var(--text-2);
    line-height: 1.5;
  }
  .case-head__actions { margin-block-start: var(--space-7); }

  .fact { margin-block-start: auto; font-size: var(--step-1); font-weight: 500; }

  .case-body { margin-block-start: var(--space-10); }
  .case-tags { margin-block-start: var(--space-8); }

  .next {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-block-start: var(--space-5);
  }
  .next__title {
    font-size: var(--step-3);
    font-variation-settings: 'wght' 500, 'wdth' 94;
  }
  .next__arrow { color: var(--accent); flex: none; }
</style>
