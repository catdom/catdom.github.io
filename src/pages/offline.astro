---
import Layout from '../layouts/Layout.astro';
import KineticHeading from '../components/KineticHeading.astro';
---

<Layout title="Offline" description="You are offline." variant="inner">
  <section class="section offline">
    <div class="container">
      <p class="label">No connection</p>
      <KineticHeading text="You are offline." as="h1" animateEntrance={false} />
      <p class="measure text-2 offline__body">
        Pages you have already visited are cached and still available. This one
        will refresh itself as soon as the connection returns.
      </p>
      <a class="btn btn--primary offline__cta" href="/">Try the home page</a>
    </div>
  </section>
</Layout>

<script>
  // Reload the moment connectivity comes back, so the visitor is not stuck
  // looking at a fallback page that is no longer accurate.
  addEventListener('online', () => location.reload());
</script>

<style>
  .offline { padding-block-start: clamp(4rem, 14vh, 10rem); min-block-size: 60svh; }
  .offline .label { margin-block-end: var(--space-4); }
  .offline__body { margin-block-start: var(--space-5); font-size: var(--step-1); }
  .offline__cta { margin-block-start: var(--space-7); }
</style>
