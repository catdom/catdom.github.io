---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BentoCard from '../components/BentoCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import KineticHeading from '../components/KineticHeading.astro';
import StatusPill from '../components/StatusPill.astro';
import CopyEmail from '../components/CopyEmail.astro';
import Icon from '../components/Icon.astro';
import { profile, IS_PLACEHOLDER } from '../lib/profile';

const all = (await getCollection('projects', ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = all.filter((p) => p.data.featured);
const archive = all.filter((p) => !p.data.featured);
---

<Layout variant="home">
  {
    IS_PLACEHOLDER && (
      <div class="placeholder-banner">
        <div class="container">
          <strong>Placeholder content.</strong> Every name, project and link on
          this page is filler. Edit <code>src/lib/profile.ts</code> and the files
          in <code>src/content/projects/</code> to make it yours — search for
          the ⚑ marks.
        </div>
      </div>
    )
  }

  <!-- ══ HERO ══════════════════════════════════════════════════════════ -->
  <section class="section hero">
    <div class="container">
      <div class="cluster hero__meta">
        <StatusPill />
        <p class="label">{profile.location} · {profile.role}</p>
      </div>

      <KineticHeading
        text={profile.headline}
        as="h1"
        animateEntrance={false}
        class="hero__headline"
      />

      <p class="hero__standfirst measure">{profile.standfirst}</p>

      <div class="cluster hero__actions">
        <a class="btn btn--primary" href="#work">
          See the work
          <Icon name="arrow-right" size={16} />
        </a>
        <a class="btn" href="#contact">Get in touch</a>
        {profile.cvHref && (
          <a
            class="btn btn--ghost"
            href={profile.cvHref}
            download
            data-astro-prefetch="false"
          >
            Download CV
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- ══ TICKER ════════════════════════════════════════════════════════ -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {
        [0, 1].map(() =>
          profile.stack.map((item) => <span class="marquee__item">{item}</span>),
        )
      }
    </div>
  </div>

  <!-- ══ WORK ══════════════════════════════════════════════════════════ -->
  <section class="section" id="work">
    <div class="container">
      <div class="section__head">
        <p class="label label--index" data-index="01">Selected work</p>
        <KineticHeading text="Things I have shipped." class="kinetic--sm" />
      </div>

      <div class="bento">
        {featured.map((project, i) => <ProjectCard project={project} index={i} />)}
      </div>

      {
        archive.length > 0 && (
          <div class="archive-wrap">
            <p class="label">Also</p>
            <ul class="archive" role="list">
              {archive.map((p) => (
                <li>
                  <a class="archive__row" href={`/work/${p.id}`}>
                    <span class="archive__year">{p.data.year}</span>
                    <span class="archive__title">{p.data.title}</span>
                    <span class="archive__meta">{p.data.tags[0]}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <!-- ══ ABOUT ═════════════════════════════════════════════════════════ -->
  <section class="section" id="about">
    <div class="container">
      <div class="section__head">
        <p class="label label--index" data-index="02">About</p>
        <KineticHeading text="How I work." class="kinetic--sm" />
      </div>

      <div class="bento">
        <BentoCard col={8} row={2} label="Biography">
          <div class="bio">
            {profile.bio.map((para) => <p>{para}</p>)}
          </div>
        </BentoCard>

        <BentoCard col={4} row={1} quiet label="Capabilities">
          <ul class="caps" role="list">
            {profile.capabilities.map((c) => (
              <li>
                <Icon name="dot" size={8} class="caps__dot" />
                {c}
              </li>
            ))}
          </ul>
        </BentoCard>

        <BentoCard col={4} row={1} quiet label="Now">
          <p class="now">{profile.availability.detail}</p>
          <p class="push-end label">{profile.timezone}</p>
        </BentoCard>

        {
          profile.metrics.map((m) => (
            <BentoCard col={4} row={1} quiet>
              <p class="metric__value">
                {m.value}
                <span class="metric__unit">{m.unit}</span>
              </p>
              <p class="push-end label">{m.note}</p>
            </BentoCard>
          ))
        }

        <BentoCard col={12} row={1} label="Career">
          <ul class="cv" role="list">
            {
              profile.experience.map((job) => (
                <li class="cv__row">
                  <span class="cv__role">{job.role}</span>
                  <span class="cv__org text-2">{job.org}</span>
                  <span class="cv__period label">{job.period}</span>
                </li>
              ))
            }
          </ul>
        </BentoCard>
      </div>
    </div>
  </section>

  <!-- ══ CONTACT ═══════════════════════════════════════════════════════ -->
  <section class="section" id="contact">
    <div class="container">
      <div class="section__head">
        <p class="label label--index" data-index="03">Contact</p>
        <KineticHeading text="Let us build something." class="kinetic--sm" />
      </div>

      <div class="bento">
        <BentoCard col={8} row={2} label="Email — the only channel I check daily">
          <p class="contact__lede">
            No contact form, deliberately. Mail lands where I actually read it,
            and nothing about your visit is logged, tracked or sent anywhere.
          </p>
          <div class="push-end" style="padding-block-start: var(--space-6)">
            <CopyEmail />
          </div>
        </BentoCard>

        <BentoCard col={4} row={2} quiet label="Elsewhere">
          <ul class="socials" role="list">
            {
              profile.socials.map((s) => (
                <li>
                  <a class="socials__link" href={s.href} rel="me noopener" target="_blank">
                    <span>{s.label}</span>
                    <span class="socials__handle">{s.handle}</span>
                    <Icon name="arrow-ne" size={15} class="socials__arrow" />
                  </a>
                </li>
              ))
            }
          </ul>
        </BentoCard>
      </div>
    </div>
  </section>
</Layout>

<style>
  .placeholder-banner {
    background: var(--accent);
    color: var(--accent-ink);
    padding-block: var(--space-3);
    font-size: var(--step--1);
  }
  .placeholder-banner code {
    background: rgb(0 0 0 / 0.18);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
  }

  /* ---- hero ---- */
  .hero { padding-block-start: clamp(3rem, 8vh, 7rem); }
  .hero__meta { gap: var(--space-4); }
  .hero__headline { margin-block-start: var(--space-6); }
  .hero__standfirst {
    margin-block-start: var(--space-6);
    font-size: var(--step-1);
    color: var(--text-2);
    line-height: 1.5;
  }
  .hero__actions { margin-block-start: var(--space-8); gap: var(--space-3); }

  /* ---- section heads ---- */
  .section__head { margin-block-end: var(--space-8); }
  .section__head .label { margin-block-end: var(--space-4); }

  /* ---- about ---- */
  .bio > p + p { margin-block-start: var(--space-4); }
  .bio p { color: var(--text-2); max-width: 58ch; }

  .caps { margin-block-start: var(--space-5); font-size: var(--step--1); }
  .caps li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: 3px;
    color: var(--text-2);
  }
  .caps__dot { color: var(--accent); flex: none; }

  .now { margin-block-start: var(--space-5); color: var(--text-2); font-size: var(--step--1); }

  .metric__value {
    margin-block-start: auto;
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1;
    letter-spacing: var(--track-tight);
    font-variation-settings: 'wght' 560, 'wdth' 88;
  }
  .metric__unit {
    display: block;
    margin-block-start: var(--space-2);
    font-family: var(--font-text);
    font-size: var(--step--1);
    letter-spacing: 0;
    color: var(--text-2);
    font-variation-settings: normal;
  }

  .cv { margin-block-start: var(--space-5); }
  .cv__row {
    display: grid;
    gap: var(--space-1) var(--space-4);
    grid-template-columns: 1fr;
    padding-block: var(--space-3);
    border-block-start: var(--border) solid var(--hairline);
  }
  .cv__row:first-child { border-block-start: 0; }
  @media (min-width: 40rem) {
    .cv__row { grid-template-columns: 1.2fr 1fr auto; align-items: baseline; }
  }
  .cv__role { font-weight: 500; }

  /* ---- archive ---- */
  .archive-wrap { margin-block-start: var(--space-9); }
  .archive-wrap .label { margin-block-end: var(--space-4); }

  /* ---- contact ---- */
  .contact__lede {
    margin-block-start: var(--space-5);
    max-width: 46ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--text-2);
  }
  .socials { margin-block-start: var(--space-5); }
  .socials__link {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-block-end: var(--border) solid var(--hairline);
    font-size: var(--step--1);
    transition: padding-inline var(--dur-base) var(--ease-out);
  }
  .socials li:last-child .socials__link { border-block-end: 0; }
  .socials__link:hover { padding-inline-start: var(--space-2); }
  .socials__handle { font-family: var(--font-mono); font-size: var(--step--2); color: var(--text-3); }
  .socials__arrow { color: var(--text-3); transition: color var(--dur-fast) var(--ease-out); }
  .socials__link:hover .socials__arrow { color: var(--accent); }
</style>
