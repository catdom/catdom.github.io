---
import '../styles/global.css';
import { profile } from '../lib/profile';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  variant?: 'home' | 'inner';
  ogImage?: string;
}

const {
  title,
  description = profile.seo.description,
  variant = 'home',
  ogImage = '/og/default.png',
} = Astro.props;

const pageTitle = title ? `${title} — ${profile.name}` : profile.seo.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? profile.seo.origin);
const ogUrl = new URL(ogImage, Astro.site ?? profile.seo.origin);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  url: canonical.origin,
  address: { '@type': 'PostalAddress', addressLocality: profile.location },
  sameAs: profile.socials.map((s) => s.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#fbf8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0a09" media="(prefers-color-scheme: dark)" />

    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- The display font is needed for the very first pixel painted. The
         other two are requested by CSS as soon as it parses, so only this
         one earns a preload. -->
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Theme, applied before first paint. Inline and blocking on purpose:
         any async alternative produces a flash of the wrong theme. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {
          /* Storage unavailable — fall through to the OS preference. */
        }
      })();
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav variant={variant} />
    <main id="main"><slot /></main>
    <Footer />

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
